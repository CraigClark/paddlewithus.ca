<?php

/**
 * @file
 * Hook implementations for the PICC Attendance module.
 */

use Drupal\Core\Template\Attribute;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_cron().
 *
 * Runs the 3-year retention purge once every 24 hours.
 * @see \Drupal\picc_attendance\Service\AttendancePurger
 */
function picc_attendance_cron() {
  if (\Drupal::hasService('picc_attendance.purger')) {
    \Drupal::service('picc_attendance.purger')->runIfDue();
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Injects two dynamic conditions on the coach attendance view:
 *
 * 1. Product must have field_track_attendance = 1.
 * 2. Today (site timezone) must fall within the variation's
 *    field_date_range [value, end_value].
 *
 * Kept in PHP rather than YAML because "today" is inherently dynamic
 * and matching picc_registration's `hook_views_query_alter()` pattern
 * for birth-date filtering in the `participants` view.
 */
function picc_attendance_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() !== 'picc_attendance') {
    return;
  }

  /** @var \Drupal\views\Plugin\views\query\Sql $query */
  $tz_name = \Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get();
  $today = (new \DateTimeImmutable('@' . \Drupal::time()->getRequestTime()))
    ->setTimezone(new \DateTimeZone($tz_name))
    ->format('Y-m-d');

  // Single WHERE expression keyed off commerce_order_item.purchased_entity,
  // which is always present on the base table — avoids the need to resolve
  // the Views-aliased variation table. Using distinct placeholder names
  // because PDO does not allow the same placeholder to appear twice.
  $query->addWhereExpression(
    0,
    "commerce_order_item.purchased_entity IN (
      SELECT v.variation_id
      FROM {commerce_product_variation_field_data} v
      INNER JOIN {commerce_product__field_track_attendance} t
        ON t.entity_id = v.product_id
        AND t.field_track_attendance_value = 1
      INNER JOIN {commerce_product_variation__field_date_range} d
        ON d.entity_id = v.variation_id
        AND d.field_date_range_value <= :picc_att_today_start
        AND d.field_date_range_end_value >= :picc_att_today_end
    )",
    [
      ':picc_att_today_start' => $today,
      ':picc_att_today_end' => $today,
    ]
  );
}

/**
 * Implements hook_form_alter().
 *
 * Reorders the attendance-history exposed filters so select- and text-style
 * filters render on the top row (flex-wrapped in CSS) and the boolean
 * toggles stack beneath them, with actions last. Only affects rendering —
 * query semantics are untouched.
 */
function picc_attendance_form_views_exposed_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  if (($form['#id'] ?? '') !== 'views-exposed-form-picc-attendance-history-page-1') {
    return;
  }

  // Lower weight renders earlier. Name field lives on its own top row
  // (CSS gives it flex-basis: 100%). Date/program selects share the next
  // row; the three toggles stack after; actions render last.
  $weights = [
    'field_name'               => 5,
    'date_from_wrapper'        => 10,
    'date_to_wrapper'          => 12,
    'product_selective'        => 20,
    'pickup_other_only'        => 40,
    'flag_only'                => 42,
    'checkin_without_checkout' => 44,
    'actions'                  => 100,
  ];
  foreach ($weights as $key => $weight) {
    if (isset($form[$key])) {
      $form[$key]['#weight'] = $weight;
    }
  }
  $form['#sorted'] = FALSE;
}

/**
 * Implements hook_preprocess_views_view_table() for picc_attendance_history.
 *
 * Adds a CSS modifier class to each row reflecting the completeness of the
 * attendance record, so the theme can highlight edge cases:
 *
 * - `attendance-row--no-show`   : no check-in and no check-out on record.
 * - `attendance-row--incomplete`: exactly one of check-in / check-out is set.
 *
 * Fully complete rows (both present) get no extra class. Uses the row entity
 * rather than the rendered markup — robust against label changes / translation.
 */
function picc_attendance_preprocess_views_view_table(array &$variables) {
  if (($variables['view']->id() ?? '') !== 'picc_attendance_history') {
    return;
  }

  foreach ($variables['rows'] as $delta => &$row) {
    $result = $variables['view']->result[$delta] ?? NULL;
    $entity = $result && isset($result->_entity) ? $result->_entity : NULL;
    if (!$entity || !$entity instanceof \Drupal\picc_attendance\Entity\AttendanceInterface) {
      continue;
    }
    $has_in = !empty($entity->get('check_in_at')->value);
    $has_out = !empty($entity->get('check_out_at')->value);

    if (!$has_in && !$has_out) {
      $modifier = 'attendance-row--no-show';
    }
    elseif ($has_in xor $has_out) {
      $modifier = 'attendance-row--incomplete';
    }
    else {
      continue;
    }

    $existing = $row['attributes'] ?? new Attribute();
    if (!$existing instanceof Attribute) {
      $existing = new Attribute(is_array($existing) ? $existing : []);
    }
    $existing->addClass('attendance-row', $modifier);
    $row['attributes'] = $existing;
  }
}
