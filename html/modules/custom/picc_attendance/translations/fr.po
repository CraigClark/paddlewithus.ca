# ============================================================
# Coach attendance view — page titles, empty state, result count
# ============================================================
msgid "Attendance (today)"
msgstr "Présences (aujourd'hui)"

msgid "Attendance history"
msgstr "Historique des présences"

# ============================================================
# Action labels (buttons + badges on the coach roster)
# ============================================================
msgid "Check in"
msgstr "Arrivée"

msgid "Check out"
msgstr "Départ"

msgid "Reset check-in"
msgstr "Annuler l'arrivée"

msgid "Reset check-out"
msgstr "Annuler le départ"

msgid "Reset"
msgstr "Annuler"

# Status badges rendered by AttendanceAction views field plugin
msgid "In @time"
msgstr "Arrivé à @time"

msgid "Out @time"
msgstr "Parti à @time"

msgid "Out @time (no check-in)"
msgstr "Parti à @time (sans arrivée)"

msgid "Check-out recorded without prior check-in"
msgstr "Départ enregistré sans arrivée préalable"

# ============================================================
# Check-in form
# ============================================================
msgid "Check in @name"
msgstr "Arrivée de @name"

msgid "Note (optional)"
msgstr "Note (optionnelle)"

msgid "Anything worth recording — e.g. \"Arrived late\". Do not record critical information like medication changes here; use the participant profile."
msgstr "Toute information utile — par ex. « Arrivé en retard ». Ne pas inscrire ici d'information critique comme un changement de médicaments ; utiliser le profil du participant."

msgid "@name checked in."
msgstr "@name est arrivé."

msgid "Registration not found."
msgstr "Inscription introuvable."

# ============================================================
# Check-out form
# ============================================================
msgid "Check out @name"
msgstr "Départ de @name"

msgid "Picked up by"
msgstr "Récupéré par"

msgid "Select the person picking up @name. Only one person can be selected."
msgstr "Sélectionner la personne qui récupère @name. Une seule personne peut être sélectionnée."

msgid "Self checkout (@name)"
msgstr "Départ autonome (@name)"

msgid "Other (enter name)"
msgstr "Autre (entrer le nom)"

msgid "Name of other person"
msgstr "Nom de l'autre personne"

msgid "Please enter the name of the person picking up."
msgstr "Veuillez entrer le nom de la personne qui récupère le participant."

msgid "Please add a note explaining the pickup since \"Other\" was selected."
msgstr "Veuillez ajouter une note expliquant la situation puisque « Autre » a été sélectionné."

msgid "An unlisted person is picking up @name. Explain why in the note below — the record is flagged for manager review."
msgstr "Une personne non autorisée récupère @name. Expliquer la situation dans la note ci-dessous — le dossier sera signalé pour examen par un gestionnaire."

msgid "Note"
msgstr "Note"

msgid "Anything worth recording — e.g. \"Biked home with parent consent\", \"Sick, picked up early\". Required when \"Other\" is selected."
msgstr "Toute information utile — par ex. « Rentré à vélo avec l'accord du parent », « Malade, récupéré plus tôt ». Requise si « Autre » est sélectionné."

msgid "This participant was not checked in today. The check-out will be flagged as \"without check-in\"."
msgstr "Ce participant n'a pas été enregistré à son arrivée aujourd'hui. Le départ sera marqué « sans arrivée »."

msgid "No authorised emergency contacts are on file for @name. Select self checkout or enter the name of the person picking up manually. This will be flagged in the record."
msgstr "Aucun contact d'urgence autorisé n'est enregistré pour @name. Sélectionner le départ autonome ou entrer le nom de la personne qui récupère. Ceci sera noté au dossier."

msgid "@name checked out with @pickup."
msgstr "@name est parti avec @pickup."

# ============================================================
# Reset form
# ============================================================
msgid "Reset @slot for @name"
msgstr "Annuler l'@slot pour @name"

msgid "check-in"
msgstr "arrivée"

msgid "check-out"
msgstr "départ"

msgid "The original @slot value will remain in the audit history. Enter a short reason so the record is traceable."
msgstr "La valeur d'@slot originale reste dans l'historique d'audit. Entrer une courte raison pour la traçabilité."

msgid "Reason"
msgstr "Raison"

msgid "For example: \"Clicked the wrong participant\", \"Entered by mistake\"."
msgstr "Par exemple : « Mauvais participant cliqué », « Entrée par erreur »."

msgid "@slot reset."
msgstr "@slot annulé."

msgid "Check-in"
msgstr "Arrivée"

msgid "Check-out"
msgstr "Départ"

msgid "Attendance record or slot not found."
msgstr "Dossier de présence ou champ introuvable."

