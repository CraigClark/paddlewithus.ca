# ============================================================
# Menu links + admin group
# ============================================================
msgid "Attendance"
msgstr "Présences"

msgid "PICC"
msgstr "PICC"

msgid "Petrie Island Canoe Club settings."
msgstr "Paramètres du Club de canoë de l'île Petrie."

msgid "Check in and out participants for today's programs."
msgstr "Enregistrer les arrivées et les départs des participants pour les programmes du jour."

msgid "Configure retention, run manual purges, view last-run stats."
msgstr "Configurer la rétention, lancer des suppressions manuelles, voir les statistiques."

msgid "Administrative list of all attendance records."
msgstr "Liste administrative de tous les dossiers de présence."

msgid "Browse and export historical attendance records."
msgstr "Parcourir et exporter les dossiers de présence archivés."

