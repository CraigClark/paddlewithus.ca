# ============================================================
# Entity field labels (admin view of a record)
# ============================================================
msgid "Order item"
msgstr "Article de commande"

msgid "The order item (registration) this attendance record belongs to."
msgstr "L'article de commande (inscription) auquel ce dossier de présence est rattaché."

msgid "Participant profile at the time of record creation."
msgstr "Profil du participant au moment de la création du dossier."

msgid "Program (Commerce product) at the time of record creation."
msgstr "Programme (produit Commerce) au moment de la création du dossier."

msgid "Calendar day of attendance, site timezone."
msgstr "Jour de présence, fuseau horaire du site."

msgid "When the coach tapped Check in. Null until checked in."
msgstr "Moment où l'entraîneur a enregistré l'arrivée. Vide tant que non enregistré."

msgid "When the coach tapped Check out. Null until checked out."
msgstr "Moment où l'entraîneur a enregistré le départ. Vide tant que non enregistré."

msgid "Coach who recorded the check-in."
msgstr "Entraîneur qui a enregistré l'arrivée."

msgid "Coach who recorded the check-out."
msgstr "Entraîneur qui a enregistré le départ."

msgid "Optional free-text note captured at check-in."
msgstr "Note libre optionnelle saisie à l'arrivée."

msgid "Optional free-text note captured at check-out."
msgstr "Note libre optionnelle saisie au départ."

msgid "Name of the person who picked up the participant."
msgstr "Nom de la personne ayant récupéré le participant."

msgid "Which emergency contact or free-text option was chosen."
msgstr "Quel contact d'urgence ou option libre a été choisi."

msgid "Checked out without prior check-in"
msgstr "Départ sans arrivée préalable"

msgid "True if at the moment of check-out no check-in was active. Reflects final non-reset state."
msgstr "Vrai si, au moment du départ, aucune arrivée n'était active. Reflète l'état final hors annulation."

msgid "Created"
msgstr "Créé"

msgid "Changed"
msgstr "Modifié"

msgid "When the record was created."
msgstr "Moment de création du dossier."

msgid "When the record was last changed."
msgstr "Moment de la dernière modification du dossier."

# ============================================================
# Settings form
# ============================================================
msgid "PICC Attendance settings"
msgstr "Paramètres de présences PICC"

msgid "Attendance settings"
msgstr "Paramètres des présences"

msgid "Retention window (days)"
msgstr "Période de rétention (jours)"

msgid "Attendance records whose date is older than this many days will be purged automatically (3 years = 1095)."
msgstr "Les dossiers de présence plus anciens que ce nombre de jours sont supprimés automatiquement (3 ans = 1095)."

msgid "Purge status"
msgstr "État de la suppression"

msgid "Last purge: @time"
msgstr "Dernière suppression : @time"

msgid "never"
msgstr "jamais"

msgid "Purges run automatically once every 24 hours via cron. Use the button below only if you need to force an immediate purge (e.g. after changing the retention window)."
msgstr "Les suppressions s'exécutent automatiquement toutes les 24 heures via cron. N'utiliser le bouton ci-dessous que pour forcer une suppression immédiate (par ex. après un changement de la période de rétention)."

msgid "Run purge now"
msgstr "Lancer la suppression maintenant"

msgid "Purge complete. @count record(s) deleted."
msgstr "Suppression terminée. @count dossier(s) supprimé(s)."

# ============================================================
# Permissions
# ============================================================
msgid "Record PICC attendance (check-in / check-out / reset today)"
msgstr "Enregistrer les présences PICC (arrivée / départ / annulation du jour)"

msgid "Allows coaches to record check-in and check-out for participants in programs that are active today. Limited to the current day."
msgstr "Permet aux entraîneurs d'enregistrer arrivées et départs pour les participants des programmes actifs aujourd'hui. Limité au jour en cours."

msgid "View PICC attendance history"
msgstr "Voir l'historique des présences PICC"

msgid "Allows viewing all historical attendance records (admin history view + CSV export)."
msgstr "Permet de voir tous les dossiers de présence archivés (vue admin + export CSV)."

msgid "Administer PICC attendance"
msgstr "Administrer les présences PICC"

msgid "Configure retention settings, run manual purges, edit and delete attendance records. Bypass the daily time-window rule."
msgstr "Configurer la rétention, lancer des suppressions manuelles, modifier et supprimer des dossiers. Contourner la règle de fenêtre quotidienne."

