<?php

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\commerce_product\Entity\ProductInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\image\Entity\ImageStyle;

/**
 * Implements hook_page_attachments().
 *
 * Attaches a stylesheet from the front-end theme on every admin route, so
 * admin overrides apply regardless of which admin theme is active.
 */
function picc_ext_page_attachments(array &$attachments) {
    if (\Drupal::service("router.admin_context")->isAdminRoute()) {
        $attachments["#attached"]["library"][] = "daisyui_ext/framework-admin";
    }
}

/**
 * Implements hook_link_alter().
 *
 * Suppresses ui_icons_menu_link_alter() on admin routes so menu link titles
 * stay readable in the admin menu management list (otherwise an icon_only
 * link displays as just the icon, with no text to identify which link is
 * which). Front-end menu rendering goes through hook_preprocess_menu, which
 * is not affected by this flag.
 *
 * Runs before ui_icons_menu_link_alter (picc_ext comes before ui_icons_menu
 * alphabetically); the flag tells that hook to skip rewriting the text.
 */
function picc_ext_link_alter(array &$variables): void {
    if (!isset($variables['url'])) {
        return;
    }
    if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
        return;
    }
    $variables['url']->setOption('ui_icons_processed', TRUE);
}

/**
 * Implements hook_library_info_alter().
 *
 * Swaps the material_icons module's Google Fonts CDN libraries for a locally
 * hosted copy shipped from the daisyui_ext theme. The font is the same
 * Material Icons baseline glyph set; only the source changes (CDN -> local).
 *
 * Applies regardless of active theme, so the picker on admin pages and the
 * icons on the front end both load the local font.
 */
function picc_ext_library_info_alter(array &$libraries, string $extension): void {
    if ($extension !== 'material_icons') {
        return;
    }
    if (!isset($libraries['baseline'])) {
        return;
    }
    $libraries['baseline']['css']['theme'] = [
        '/themes/custom/daisyui_ext/css/material-icons.css' => [],
    ];
}

/**
 * Self-register form: set a first-login flag and redirect back to show message.
 */
function picc_ext_form_user_register_form_alter(
    &$form,
    FormStateInterface $form_state,
    $form_id
) {
    // Only on the self-register route.
    if (\Drupal::routeMatch()->getRouteName() !== "user.register") {
        return;
    }

    // Attach to the submit button.
    if (isset($form["actions"]["submit"])) {
        // After core creates the user, mark them for the one-time redirect.
        $form["actions"]["submit"]["#submit"][] =
            "picc_ext_register_set_first_login_flag_submit";

        // Redirect back so the core "check your email" message shows immediately.
        $form["actions"]["submit"]["#submit"][] =
            "picc_ext_register_redirect_back_submit";
    }
}

/**
 * After self-register, mark the user as needing the one-time redirect.
 */
function picc_ext_register_set_first_login_flag_submit(
    &$form,
    FormStateInterface $form_state
) {
    $form_object = $form_state->getFormObject();
    if (!$form_object || !method_exists($form_object, "getEntity")) {
        return;
    }

    $account = $form_object->getEntity();
    if (!$account || !$account->id()) {
        return;
    }

    \Drupal::service("user.data")->set(
        "picc_ext",
        (int) $account->id(),
        "first_login_pending",
        1
    );
}

/**
 * After self-register, redirect back to /{lang}/user/register so "check email" shows now.
 */
function picc_ext_register_redirect_back_submit(
    &$form,
    FormStateInterface $form_state
) {
    // If validation failed, don't redirect.
    if ($form_state->hasAnyErrors()) {
        return;
    }

    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $form_state->setRedirectUrl(
        Url::fromUserInput("/" . $langcode . "/user/register")
    );
}

/**
 * Global form alter:
 * - Attach handler on password reset request route (user.pass) regardless of form_id.
 * - Attach handler on user edit form to redirect once after first one-time login save.
 */
function picc_ext_form_alter(&$form, FormStateInterface $form_state, $form_id)
{
    $route_name = \Drupal::routeMatch()->getRouteName();

    // Password reset request page: /user/password (routes to user.pass).
    if ($route_name === "user.pass") {
        if (!isset($form["#submit"]) || !is_array($form["#submit"])) {
            $form["#submit"] = [];
        }
        $form["#submit"][] = "picc_ext_pass_redirect_back_submit";
        return;
    }

    // User edit form: attach one-time post-first-login redirect logic.
    if ($form_id === "user_form" && isset($form["actions"]["submit"])) {
        $form["actions"]["submit"]["#submit"][] =
            "picc_ext_user_form_first_login_redirect_submit";
    }
}

/**
 * After requesting password reset email, redirect back so the "check your email"
 * message shows immediately — but ONLY if there were no validation errors.
 */
function picc_ext_pass_redirect_back_submit(
    &$form,
    FormStateInterface $form_state
) {
    if ($form_state->hasAnyErrors()) {
        return;
    }

    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $form_state->setRedirectUrl(
        Url::fromUserInput("/" . $langcode . "/user/password")
    );
}

/**
 * Redirect once after first-login profile completion (token flow only).
 *
 * - First login (flag set) + token flow => redirect to /{lang}/program + message.
 * - Password reset token flow or normal profile edit => leave default behaviour.
 */
function picc_ext_user_form_first_login_redirect_submit(
    &$form,
    FormStateInterface $form_state
) {
    $request = \Drupal::request();

    // Only for the one-time login link flow.
    if (!$request->query->has("pass-reset-token")) {
        return;
    }

    $form_object = $form_state->getFormObject();
    if (!$form_object || !method_exists($form_object, "getEntity")) {
        return;
    }

    $account = $form_object->getEntity();
    if (!$account || !$account->id()) {
        return;
    }

    $user_data = \Drupal::service("user.data");
    $pending = (int) $user_data->get(
        "picc_ext",
        (int) $account->id(),
        "first_login_pending"
    );

    // Not pending => password reset or other token flow: do nothing.
    if ($pending !== 1) {
        return;
    }

    // Clear flag so it happens only once.
    $user_data->set("picc_ext", (int) $account->id(), "first_login_pending", 0);

    \Drupal::messenger()->addStatus(
        t(
            "Your account is ready! You can now explore programs and register yourself or others."
        )
    );

    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $form_state->setRedirectUrl(
        Url::fromUserInput("/" . $langcode . "/program")
    );
}

/**
 * Implements hook_menu_local_actions_alter().
 */
function picc_ext_menu_local_actions_alter(array &$local_actions): void
{
    // Remove the "Add payment method" local action from the Payment methods tab.
    // This local action points to entity.commerce_payment_method.add_form and
    // appears on the payment method collection route.
    foreach ($local_actions as $plugin_id => $definition) {
        // $definition is an array (plugin definition), not an object.
        $route_name = $definition["route_name"] ?? "";
        $appears_on = $definition["appears_on"] ?? [];

        // Remove the add form action anywhere it appears.
        if ($route_name === "entity.commerce_payment_method.add_form") {
            unset($local_actions[$plugin_id]);
            continue;
        }

        // Extra safety: remove any action that appears on the payment method collection route.
        if (
            in_array(
                "entity.commerce_payment_method.collection",
                $appears_on,
                true
            )
        ) {
            // Only remove if it's specifically the "add" action (avoid nuking other actions).
            if ($route_name === "entity.commerce_payment_method.add_form") {
                unset($local_actions[$plugin_id]);
            }
        }
    }
}

/**
 * Implements hook_views_query_alter().
 *
 * On the variant_session view, keeps a tracked-bundle variation visible if it
 * either has positive remaining stock OR has at least one completed/fulfilled
 * registration. The second clause lets sold-out sessions render as "Full"
 * while still hiding misconfigured sessions that were never stocked AND never
 * registered against.
 */
function picc_ext_views_query_alter($view, $query) {
    if ($view->id() !== 'variant_session') {
        return;
    }

    // Get the list of variation bundles using a stock-tracked service.
    $stock_config = \Drupal::config('commerce_stock.service_manager');
    $tracked_bundles = [];
    foreach ($stock_config->get() as $key => $service_id) {
        if (strpos($key, 'commerce_product_variation_') === 0
            && str_ends_with($key, '_service_id')
            && $service_id !== 'always_in_stock'
        ) {
            $bundle = substr($key, strlen('commerce_product_variation_'), -strlen('_service_id'));
            $tracked_bundles[] = $bundle;
        }
    }

    if (empty($tracked_bundles)) {
        return;
    }

    $connection = \Drupal::database();

    // Variation IDs that have positive remaining stock.
    $stock_subquery = $connection->select('commerce_stock_transaction', 'st')
        ->fields('st', ['entity_id']);
    $stock_subquery->condition('st.entity_type', 'commerce_product_variation');
    $stock_subquery->groupBy('st.entity_id');
    $stock_subquery->having('SUM(st.qty) > 0');

    // Variation IDs that have at least one completed/fulfilled registration.
    $registration_subquery = $connection->select('commerce_order_item', 'oi');
    $registration_subquery->join('commerce_order__order_items', 'ooi', 'ooi.order_items_target_id = oi.order_item_id');
    $registration_subquery->join('commerce_order', 'o', 'o.order_id = ooi.entity_id');
    $registration_subquery->fields('oi', ['purchased_entity']);
    $registration_subquery->condition('oi.type', ['activity_registration', 'swim_test_registration'], 'IN');
    $registration_subquery->condition('o.state', ['completed', 'fulfillment'], 'IN');
    $registration_subquery->isNotNull('oi.purchased_entity');

    // Include a variation if it's an untracked bundle, OR has positive stock,
    // OR has a real registration (sold out but still legitimate).
    $condition = $query->getConnection()->condition('OR');
    $condition->condition('commerce_product_variation_field_data.type', $tracked_bundles, 'NOT IN');
    $condition->condition('commerce_product_variation_field_data.variation_id', $stock_subquery, 'IN');
    $condition->condition('commerce_product_variation_field_data.variation_id', $registration_subquery, 'IN');
    $query->addWhere(0, $condition);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 * Adds a stylesheet to theme that can be read by the
 * admin theme
 */
function daisyui_ext_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
 // Admin css and js to node edit/add forms.
 $form['#attached']['library'][] = 'daisyui_ext/framework-admin';
}

/**
 * Implements hook_ENTITY_TYPE_view() for commerce_product.
 *
 * Emits Schema.org Event JSON-LD on the full product page for activity
 * products. One Event per published variation. Multiple variations are
 * emitted as a flat list under @graph rather than wrapped in EventSeries,
 * because Google's Event rich results explicitly do NOT support EventSeries
 * (https://developers.google.com/search/docs/appearance/structured-data/event)
 * — each performance has to stand on its own.
 *
 * Dates and prices come from the variation (field_date_range + Commerce
 * price); location is the clubhouse PostalAddress below; organizer matches
 * the Organization JSON-LD set in metatag.metatag_defaults.global.
 *
 * Variation tokens don't traverse from product context in metatag, which is
 * why this lives in PHP instead of schema_metatag config.
 */
function picc_ext_commerce_product_view(array &$build, ProductInterface $product, EntityViewDisplayInterface $display, $view_mode) {
    if ($product->bundle() !== 'activity' || $view_mode !== 'full') {
        return;
    }

    $events = _picc_ext_build_activity_events($product);
    if (!$events) {
        return;
    }

    if (count($events) === 1) {
        $graph = ['@context' => 'https://schema.org'] + $events[0];
    }
    else {
        $graph = [
            '@context' => 'https://schema.org',
            '@graph' => $events,
        ];
    }

    // Markup::create() bypasses Drupal's HTML escaping so ampersands and other
    // characters in JSON values (e.g. image style query strings) round-trip
    // intact as JSON, not as HTML entities.
    $build['#attached']['html_head'][] = [
        [
            '#tag' => 'script',
            '#attributes' => ['type' => 'application/ld+json'],
            '#value' => Markup::create(json_encode($graph, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT)),
        ],
        'picc_activity_event_' . $product->id(),
    ];

    // Cache by variation list too — when variations get added/edited the
    // emitted Events need to refresh.
    $metadata = CacheableMetadata::createFromRenderArray($build);
    foreach ($product->getVariations() as $variation) {
        $metadata->addCacheableDependency($variation);
    }
    $metadata->applyTo($build);
}

/**
 * Builds one Schema.org Event array per published variation of $product.
 *
 * Returns an indexed array of associative arrays ready to be JSON-encoded.
 * Empty array if no variation has a usable start date.
 */
function _picc_ext_build_activity_events(ProductInterface $product): array {
    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $product_url = $product->toUrl('canonical', ['absolute' => TRUE])->toString();
    $front_url = Url::fromRoute('<front>', [], ['absolute' => TRUE])->toString();
    $site_name = \Drupal::config('system.site')->get('name');

    $organizer = [
        '@type' => 'Organization',
        'name' => $site_name,
        'url' => $front_url,
    ];

    $location = [
        '@type' => 'Place',
        'name' => $site_name,
        'address' => [
            '@type' => 'PostalAddress',
            'streetAddress' => '795 Tweddle Rd.',
            'addressLocality' => 'Orléans',
            'addressRegion' => 'ON',
            'postalCode' => 'K4A 3P4',
            'addressCountry' => 'CA',
        ],
    ];

    $description = _picc_ext_event_description($product);
    $image_url = _picc_ext_event_image_url($product);

    $published_variations = array_filter($product->getVariations(), fn($v) => $v->isPublished());
    $single_variation = count($published_variations) === 1;

    $events = [];
    foreach ($published_variations as $variation) {
        // Skip variation types without a single date_range field (e.g.
        // swim_test_slot uses field_date + field_time_range instead).
        // No JSON-LD Event is emitted for those — the markup is only
        // relevant for paddle camp / program variations anyway.
        if (!$variation->hasField('field_date_range')) {
            continue;
        }
        $date_range = $variation->get('field_date_range');
        if ($date_range->isEmpty() || empty($date_range->value)) {
            continue;
        }

        $event = [
            '@type' => 'SportsEvent',
            'name' => $single_variation ? $product->label() : $variation->label(),
            'startDate' => $date_range->value,
            'endDate' => $date_range->end_value ?: $date_range->value,
            'eventStatus' => 'https://schema.org/EventScheduled',
            'eventAttendanceMode' => 'https://schema.org/OfflineEventAttendanceMode',
            'inLanguage' => $langcode,
            'url' => $product_url,
            'location' => $location,
            'organizer' => $organizer,
        ];

        if ($description !== '') {
            $event['description'] = $description;
        }
        if ($image_url !== '') {
            $event['image'] = $image_url;
        }

        $price = $variation->getPrice();
        if ($price) {
            $event['offers'] = [
                '@type' => 'Offer',
                'price' => (float) $price->getNumber(),
                'priceCurrency' => $price->getCurrencyCode(),
                'availability' => 'https://schema.org/InStock',
                'url' => $product_url,
            ];
            if ((float) $price->getNumber() === 0.0) {
                $event['isAccessibleForFree'] = TRUE;
            }
        }

        $events[] = $event;
    }

    return $events;
}

/**
 * Extracts a plain-text description for the Event from the product body.
 *
 * Prefers the body summary; falls back to a 200-char excerpt of the body
 * value; returns an empty string if neither is available.
 */
function _picc_ext_event_description(ProductInterface $product): string {
    if (!$product->hasField('body') || $product->get('body')->isEmpty()) {
        return '';
    }
    $body = $product->get('body')->first();
    $summary = trim((string) ($body->summary ?? ''));
    if ($summary !== '') {
        return trim(strip_tags($summary));
    }
    $value = trim((string) ($body->value ?? ''));
    if ($value === '') {
        return '';
    }
    $plain = trim(preg_replace('/\s+/', ' ', strip_tags($value)));
    return mb_substr($plain, 0, 200);
}

/**
 * Resolves the activity's primary image to an absolute social_share URL.
 *
 * Returns an empty string if no image is set or the image style is missing.
 */
function _picc_ext_event_image_url(ProductInterface $product): string {
    if (!$product->hasField('field_primary_image') || $product->get('field_primary_image')->isEmpty()) {
        return '';
    }
    $media = $product->get('field_primary_image')->first()->entity;
    if (!$media || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
        return '';
    }
    $file = $media->get('field_media_image')->first()->entity;
    if (!$file) {
        return '';
    }
    $style = ImageStyle::load('social_share');
    if (!$style) {
        return '';
    }
    return $style->buildUrl($file->getFileUri());
}
