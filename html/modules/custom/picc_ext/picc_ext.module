<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Mark self-registered users for a one-time post-login redirect to /{lang}/program.
 *
 * This runs only on /user/register (self-registration), not for admin-created users.
 */
function picc_ext_form_user_register_form_alter(
    array &$form,
    FormStateInterface $form_state,
    $form_id
): void {
    if (\Drupal::routeMatch()->getRouteName() !== "user.register") {
        return;
    }

    // Run after core saves the new user entity.
    $form["actions"]["submit"]["#submit"][] =
        "picc_ext_mark_first_login_pending_submit";
}

/**
 * Submit handler: set first-login flag for self-registered users.
 */
function picc_ext_mark_first_login_pending_submit(
    array &$form,
    FormStateInterface $form_state
): void {
    /** @var \Drupal\user\UserInterface $account */
    $account = $form_state->getFormObject()->getEntity();

    \Drupal::service("user.data")->set(
        "picc_ext",
        (int) $account->id(),
        "first_login_pending",
        1
    );
}

/**
 * Implements hook_form_alter().
 */
function picc_ext_form_alter(
    array &$form,
    FormStateInterface $form_state,
    $form_id
): void {
    if ($form_id !== "user_form") {
        return;
    }

    // Run after Drupal saves the user.
    $form["actions"]["submit"]["#submit"][] =
        "picc_ext_user_form_first_login_redirect_submit";
}

/**
 * Submit handler: redirect once after first-login profile completion.
 *
 * - If it's the first time logging in (flag set) AND we are in a token-based flow,
 *   redirect to /en/program or /fr/program and show a status message.
 * - If it's a password reset or normal profile edit, leave Drupal's default behavior.
 */
function picc_ext_user_form_first_login_redirect_submit(
    array &$form,
    FormStateInterface $form_state
): void {
    $request = \Drupal::request();

    // Only consider redirecting for token-based flows (one-time login link).
    if (!$request->query->has("pass-reset-token")) {
        return;
    }

    /** @var \Drupal\user\UserInterface $account */
    $account = $form_state->getFormObject()->getEntity();

    $user_data = \Drupal::service("user.data");
    $pending = (int) $user_data->get(
        "picc_ext",
        (int) $account->id(),
        "first_login_pending"
    );

    // Not pending => password reset or other token flow: do nothing.
    if ($pending !== 1) {
        return;
    }

    // Clear the flag so this happens only once.
    $user_data->set("picc_ext", (int) $account->id(), "first_login_pending", 0);

    \Drupal::messenger()->addStatus(
        t(
            "Your account is ready! You can now explore programs and register yourself or others."
        )
    );

    // You explicitly use /en/program and /fr/program.
    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $form_state->setRedirectUrl(
        Url::fromUserInput("/" . $langcode . "/program")
    );
}
