# Swim test evaluation form
msgid "Swim test review"
msgstr "Examen du test de natation"

msgid "Swim test evaluation"
msgstr "Évaluation du test de natation"

msgid "Participant: @name"
msgstr "Participant : @name"

msgid "Current status: <strong>@status</strong>"
msgstr "Statut actuel : <strong>@status</strong>"

msgid "Evaluation date"
msgstr "Date d'évaluation"

msgid "Defaults to today. Change only when backdating."
msgstr "Aujourd'hui par défaut. À modifier uniquement pour antidater."

msgid "Pass"
msgstr "Réussir"

msgid "Fail"
msgstr "Échouer"

msgid "Undo"
msgstr "Annuler"

msgid "Evaluate"
msgstr "Évaluer"

msgid "Passed"
msgstr "Réussi"

msgid "Failed"
msgstr "Échoué"

msgid "Attested"
msgstr "Attesté"

msgid "Exempt"
msgstr "Exempté"

msgid "Swim test required"
msgstr "Test de natation requis"

msgid "No show"
msgstr "Absent"

msgid "Excused"
msgstr "Excusé"

msgid "Pending"
msgstr "En attente"

msgid "Unknown"
msgstr "Inconnu"

msgid "Participant"
msgstr "Participant"

msgid "Participant or registration not found."
msgstr "Participant ou inscription introuvable."

msgid "Registration not found."
msgstr "Inscription introuvable."

msgid "@name marked as passed."
msgstr "@name marqué comme ayant réussi."

msgid "@name marked as failed."
msgstr "@name marqué comme ayant échoué."

msgid "@name reset to pending."
msgstr "@name réinitialisé à en attente."

# Swim test registration form
msgid "Already registered for swim test on @date"
msgstr "Déjà inscrit au test de natation le @date"

msgid "@name is already registered for a swim test on @date at @time"
msgstr "@name est déjà inscrit au test de natation le @date à @time"

msgid "@name is already registered for a swim test on @date"
msgstr "@name est déjà inscrit au test de natation le @date"

msgid "@name is already registered for this swim test slot."
msgstr "@name est déjà inscrit pour cette plage horaire de test de natation."

msgid "Already registered for this slot: @names"
msgstr "Déjà inscrit pour cette plage horaire : @names"

msgid "Already meet swim requirements (skipped): @names"
msgstr "Répond déjà aux exigences de natation (ignoré) : @names"

msgid "No new registrations were created. All selected participants are either already registered or already meet swim requirements."
msgstr "Aucune nouvelle inscription n'a été créée. Tous les participants sélectionnés sont déjà inscrits ou répondent déjà aux exigences de natation."

msgid "Registered @names for the swim test on @date."
msgstr "@names inscrit(s) au test de natation le @date."

msgid "Registration confirmed! You will receive a confirmation by email."
msgstr "Inscription confirmée ! Vous recevrez une confirmation par courriel."

msgid "Please select at least one participant."
msgstr "Veuillez sélectionner au moins un participant."

msgid "The following participants cannot register for a swim test: @list"
msgstr "Les participants suivants ne peuvent pas s'inscrire à un test de natation : @list"

msgid "@name (no birth date on file)"
msgstr "@name (aucune date de naissance au dossier)"

msgid "@name (15 or older this year — use swim attestation instead)"
msgstr "@name (15 ans ou plus cette année — utilisez plutôt l'attestation de natation)"

msgid "@name (under 15 — register for a swim test instead)"
msgstr "@name (moins de 15 ans — inscrivez-vous plutôt à un test de natation)"

msgid "This swim test slot has already passed. Please select a different slot."
msgstr "Cette plage horaire de test de natation est déjà passée. Veuillez en choisir une autre."

msgid "No swim test slot specified."
msgstr "Aucune plage horaire de test de natation spécifiée."

msgid "Swim test slot not found."
msgstr "Plage horaire de test de natation introuvable."

msgid "Invalid registration type."
msgstr "Type d'inscription invalide."

msgid "This swim test slot is no longer available."
msgstr "Cette plage horaire de test de natation n'est plus disponible."

msgid "Sorry, this swim test slot is full. Please select a different slot."
msgstr "Désolé, cette plage horaire de test de natation est complète. Veuillez en choisir une autre."

msgid "Sorry, only @available spot(s) remain for this swim test slot. You selected @requested participants."
msgstr "Désolé, il ne reste que @available place(s) pour cette plage horaire. Vous avez sélectionné @requested participants."

msgid "The registration system is busy. Please try again in a moment."
msgstr "Le système d'inscription est occupé. Veuillez réessayer dans un instant."

msgid "No store configured. Please contact administrator."
msgstr "Aucune boutique configurée. Veuillez contacter l'administrateur."

# Swim attestation
msgid "Swim attestation confirmed for: @names."
msgstr "Attestation de natation confirmée pour : @names."

msgid "Already meet swim requirements (skipped): @names."
msgstr "Répond déjà aux exigences de natation (ignoré) : @names."

msgid "Not eligible for attestation: @list"
msgstr "Non admissible à l'attestation : @list"

msgid "No attestations were recorded."
msgstr "Aucune attestation n'a été enregistrée."

msgid "You're all set."
msgstr "Tout est en règle."

msgid "All eligible family members already have a current swim attestation or passed swim test on file. Nothing to do here."
msgstr "Tous les membres admissibles de la famille ont déjà une attestation de natation ou un test réussi au dossier. Rien à faire ici."

msgid "Nothing to attest."
msgstr "Rien à attester."

msgid "You have no family members 15 or older in your account. If you need to add someone, use the link below to edit your family members."
msgstr "Vous n'avez aucun membre de la famille de 15 ans ou plus dans votre compte. Si vous devez en ajouter un, utilisez le lien ci-dessous pour modifier votre liste de membres de la famille."

# Swim test roster view
msgid "Swim test roster"
msgstr "Liste des tests de natation"

msgid "Evaluate swim test participants"
msgstr "Évaluer les participants au test de natation"

msgid "Unscheduled"
msgstr "Non planifié"

msgid "Status"
msgstr "Statut"

msgid "Failed only"
msgstr "Échoués seulement"

msgid "Search by first or last name"
msgstr "Rechercher par prénom ou nom de famille"

msgid "No participants currently need a swim test. 🎉"
msgstr "Aucun participant n'a besoin d'un test de natation pour le moment. 🎉"

msgid "Last swim test evaluation (date)"
msgstr "Dernière évaluation du test de natation (date)"

msgid "Date of the most recent pass or fail evaluation. Cleared annually."
msgstr "Date de la dernière évaluation (réussite ou échec). Réinitialisée chaque année."

msgid "Swim status badge (participant)"
msgstr "Badge de statut de natation (participant)"

msgid "Renders a colored badge from field_swim_status."
msgstr "Affiche un badge coloré à partir de field_swim_status."

msgid "Swim test action (participant)"
msgstr "Action de test de natation (participant)"

msgid "Evaluate button for participants whose status is none or failed; nothing for cleared statuses."
msgstr "Bouton Évaluer pour les participants dont le statut est aucun ou échoué; rien pour les statuts validés."

msgid "Swim test no-shows"
msgstr "Absences aux tests de natation"

msgid "Review and resolve swim test no-shows"
msgstr "Examiner et résoudre les absences aux tests de natation"

msgid "Mark resolved"
msgstr "Marquer comme résolu"

msgid "Resolved"
msgstr "Résolu"

msgid "Mark this no-show as resolved once the fee has been handled or the absence has been excused."
msgstr "Marquer cette absence comme résolue une fois que les frais ont été traités ou que l'absence a été excusée."

msgid "Reason / notes"
msgstr "Raison / notes"

msgid "Example: \"Payment received\", \"Missed due to illness\", \"Waived\"."
msgstr "Exemple : « Paiement reçu », « Absence pour maladie », « Frais annulés »."

msgid "@name no-show marked as resolved."
msgstr "Absence de @name marquée comme résolue."

msgid "@name reset to @status."
msgstr "@name réinitialisé à @status."

msgid "No outstanding swim test no-shows. 🎉"
msgstr "Aucune absence au test de natation en attente. 🎉"

msgid "Swim test action"
msgstr "Action de test de natation"

msgid "Resolved/Undo buttons for swim test no-show review."
msgstr "Boutons Résolu/Annuler pour l'examen des absences au test de natation."

msgid "No swim test registrations found."
msgstr "Aucune inscription au test de natation trouvée."

# Variant session template (variant_session view)
msgid "Register for this swim test"
msgstr "S'inscrire à ce test de natation"

msgid "Register for this session"
msgstr "S'inscrire à cette session"

msgid "Log in or create account to register"
msgstr "Connectez-vous ou créez un compte pour vous inscrire"

msgid "Free"
msgstr "Gratuit"

msgid "Almost full"
msgstr "Presque complet"

msgid "Session full"
msgstr "Séance complète"

# Participant status icons (medical / coach notes)
msgid "Medical concerns"
msgstr "Préoccupations médicales"

msgid "Medical concerns — view profile for details"
msgstr "Préoccupations médicales — consulter le profil pour les détails"

# Participant profile boolean fields (label, description, on/off labels)
msgid "Does this participant have any allergies?"
msgstr "Ce participant a-t-il des allergies?"

msgid "Select Yes if there are allergies coaches should know about (food, environmental, insect stings, medication, etc.). Select No if there are none."
msgstr "Sélectionnez Oui s’il y a des allergies que les entraîneurs devraient connaître (alimentaires, environnementales, piqûres d’insectes, médicaments, etc.). Sélectionnez Non s’il n’y en a pas."

msgid "Is there anything coaches should know to support this participant?"
msgstr "Y a-t-il des informations que les entraîneurs devraient connaître pour mieux soutenir ce participant?"

msgid "<p>This may include medical considerations (other than allergies), as well as worries, anxieties, attention or focus needs, or emotional or social considerations. Include anything that helps coaches provide a safe, positive experience.</p>\r\n<p>Please do not include general comments (for example, \"excited for camp\"). Select \"No\" if there is nothing specific to share.</p>"
msgstr "<p>Cela peut inclure des considérations médicales (autres que les allergies), ainsi que des inquiétudes, de l’anxiété, des besoins liés à l’attention ou à la concentration, ou des aspects émotionnels ou sociaux. Incluez toute information utile pour aider les entraîneurs à offrir une expérience sécuritaire et positive.</p>\r\n<p>Veuillez ne pas inclure de commentaires généraux (par exemple, « enthousiaste pour le camp »). Sélectionnez « Non » s’il n’y a rien de particulier à signaler.</p>"
