/**
 * Re-import module translations: adds Pending/Failed/Attested/Exempt badge
 * labels, the Status filter, the Unscheduled group heading, and updates to
 * the new evaluation form strings.
 *
 * The 10010 / 10011 slots in this module's history were a data migration
 * for the field_swim_test_passed_date → field_evaluation_date rename.
 * They were dropped as no-ops once it was clear no real swim-test data
 * existed yet — drush cim handles the field deletion on its own when the
 * old config is gone from disk. Numbers are intentionally skipped so
 * environments that already advanced past them stay consistent.
 */
function picc_registration_update_10012() {
  _picc_registration_import_translations();
  return 'Re-imported translations from picc_registration/translations/*.po.';
}

/**
 * Rebuild the router so the entity.profile.collection alter takes effect.
 *
 * The new RouteSubscriber swaps /admin/people/profiles to render the
 * picc_profiles_admin view instead of the contrib EntityListBuilder. The
 * view itself (views.view.picc_profiles_admin) is imported via drush cim.
 */
function picc_registration_update_10013() {
  \Drupal::service('router.builder')->rebuild();
  return 'Rebuilt router; /admin/people/profiles now renders picc_profiles_admin.';
}

