<?php

/**
 * @file
 * Install, update and uninstall functions for picc_registration.
 */

/**
 * Import the module's translations from translations/*.po.
 */
function _picc_registration_import_translations() {
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('picc_registration');
  $translations_dir = DRUPAL_ROOT . '/' . $module_path . '/translations';

  if (!is_dir($translations_dir)) {
    return;
  }

  $files = glob($translations_dir . '/*.po');
  if (!$files) {
    return;
  }

  foreach ($files as $file_path) {
    $filename = basename($file_path);
    if (!preg_match('/^([a-z-]+)\.po$/', $filename, $matches)) {
      continue;
    }
    $langcode = $matches[1];

    $file = new \stdClass();
    $file->filename = $filename;
    $file->uri = $file_path;
    $file->langcode = $langcode;
    $file->timestamp = filemtime($file_path);

    $options = [
      'langcode' => $langcode,
      'overwrite_options' => [
        'not_customized' => TRUE,
        'customized' => FALSE,
      ],
      'customized' => LOCALE_NOT_CUSTOMIZED,
      'seek' => 0,
    ];

    try {
      \Drupal\locale\Gettext::fileToDatabase($file, $options);
      \Drupal::logger('picc_registration')->notice('Imported translations from @file for @lang.', [
        '@file' => $filename,
        '@lang' => $langcode,
      ]);
    }
    catch (\Exception $e) {
      \Drupal::logger('picc_registration')->error('Failed to import @file: @msg', [
        '@file' => $filename,
        '@msg' => $e->getMessage(),
      ]);
    }
  }
}

/**
 * Implements hook_install().
 */
function picc_registration_install() {
  _picc_registration_import_translations();
}

/**
 * Backfill field_swim_status on existing participant profiles.
 *
 * Sets the default value 'none' (Swim test required) on all participant
 * profiles that don't have a swim status set yet.
 */
function picc_registration_update_10001() {
  $storage = \Drupal::entityTypeManager()->getStorage('profile');
  $ids = $storage->getQuery()
    ->condition('type', 'participant')
    ->condition('status', 1)
    ->accessCheck(FALSE)
    ->execute();

  $count = 0;
  foreach ($storage->loadMultiple($ids) as $profile) {
    $current = $profile->get('field_swim_status')->value;
    if (empty($current)) {
      $profile->set('field_swim_status', 'none');
      $profile->save();
      $count++;
    }
  }

  return "Backfilled $count participant profiles with swim status 'none'.";
}

/**
 * Import module translations from translations/*.po files.
 */
function picc_registration_update_10002() {
  _picc_registration_import_translations();
  return 'Imported translations from picc_registration/translations/*.po.';
}

/**
 * Force all swim_test_slot variations to $0 CAD.
 *
 * The price field is hidden from the admin form, so variations may have
 * been saved with NULL or inconsistent prices. Ensures every swim test
 * slot has a valid $0 price in the database.
 */
function picc_registration_update_10003() {
  $storage = \Drupal::entityTypeManager()->getStorage('commerce_product_variation');
  $ids = $storage->getQuery()
    ->condition('type', 'swim_test_slot')
    ->accessCheck(FALSE)
    ->execute();

  $count = 0;
  foreach ($storage->loadMultiple($ids) as $variation) {
    $price = $variation->getPrice();
    if (!$price || $price->getNumber() !== '0') {
      $variation->setPrice(new \Drupal\commerce_price\Price('0', 'CAD'));
      $variation->save();
      $count++;
    }
  }

  return "Set price to \$0 CAD on $count swim_test_slot variation(s).";
}

