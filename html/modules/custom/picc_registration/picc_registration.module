<?php

/**
 * @file
 * PICC Registration module file.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\webform\WebformSubmissionInterface;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Render\Markup;
use Drupal\views\ViewExecutable;

/**
 * Spots-remaining threshold for the "low availability" status on the activity
 * page. At this many or fewer remaining spots, the row gets a warning badge.
 */
const PICC_REGISTRATION_LOW_STOCK_THRESHOLD = 3;

/**
 * Implements hook_cron().
 */
function picc_registration_cron() {
  _picc_registration_annual_swim_status_reset();
  _picc_registration_auto_no_show_sweep();
}

/**
 * Resets swim test fields on all participant profiles at the start of each
 * new year. Uses a state variable to ensure it runs exactly once per year
 * and self-heals if the site was offline on Jan 1.
 */
function _picc_registration_annual_swim_status_reset() {
  $current_year = (int) date('Y');
  $state = \Drupal::state();
  $last_reset_year = (int) $state->get('picc_registration.last_swim_reset_year', 0);

  if ($last_reset_year >= $current_year) {
    return;
  }

  \Drupal::logger('picc_registration')->notice('Starting annual swim status reset for @year (last reset: @last)', [
    '@year' => $current_year,
    '@last' => $last_reset_year ?: 'never',
  ]);

  $storage = \Drupal::entityTypeManager()->getStorage('profile');
  $ids = $storage->getQuery()
    ->condition('type', 'participant')
    ->condition('status', 1)
    ->accessCheck(FALSE)
    ->execute();

  $count = 0;
  foreach ($storage->loadMultiple($ids) as $profile) {
    $swim_status = $profile->get('field_swim_status')->value ?? 'none';

    // Only update profiles that have swim data set.
    if ($swim_status === 'none'
      && empty($profile->get('field_evaluation_date')->value)
      && empty($profile->get('field_swim_attestation_date')->value)
      && empty($profile->get('field_swim_test_evaluated_by')->target_id)
      && empty($profile->get('field_swim_attestation_by')->target_id)
    ) {
      continue;
    }

    $profile->set('field_swim_status', 'none');
    $profile->set('field_evaluation_date', NULL);
    $profile->set('field_swim_test_evaluated_by', NULL);
    $profile->set('field_swim_attestation_date', NULL);
    $profile->set('field_swim_attestation_by', NULL);
    $profile->save();
    $count++;
  }

  $state->set('picc_registration.last_swim_reset_year', $current_year);

  \Drupal::logger('picc_registration')->notice('Annual swim status reset complete: @count profiles reset for @year.', [
    '@count' => $count,
    '@year' => $current_year,
  ]);
}

/**
 * Flips swim test registrations still marked "pending" to "no_show" once the
 * slot ended more than 8 hours ago. Gives coaches a window to catch up on
 * evaluations before the cron auto-flags misses.
 */
function _picc_registration_auto_no_show_sweep() {
  $order_item_storage = \Drupal::entityTypeManager()->getStorage('commerce_order_item');
  $site_tz = new \DateTimeZone(date_default_timezone_get());

  // Find all pending swim test registrations.
  $ids = $order_item_storage->getQuery()
    ->condition('type', 'swim_test_registration')
    ->condition('field_swim_test_status', 'pending')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($ids)) {
    return;
  }

  $now = new \DateTime('now');
  $flipped = 0;

  foreach ($order_item_storage->loadMultiple($ids) as $order_item) {
    // Skip if the order isn't completed.
    $order = $order_item->getOrder();
    if (!$order || !in_array($order->getState()->getId(), ['completed', 'fulfillment'])) {
      continue;
    }

    // Need both the date and the end time to compute slot end.
    $variation = $order_item->getPurchasedEntity();
    if (!$variation || !$variation->hasField('field_date') || !$variation->hasField('field_time_range')) {
      continue;
    }

    $date_value = $variation->get('field_date')->value;
    $end_value = $variation->get('field_time_range')->end_value;
    if (!$date_value || !$end_value) {
      continue;
    }

    // The slot date is a simple date (YYYY-MM-DD) in site timezone.
    // The time range end is a datetime stored in UTC.
    // Combine the date with the UTC time's H:i:s to get the slot end in site tz.
    try {
      $end_time_utc = new \DateTime($end_value, new \DateTimeZone('UTC'));
      $end_time_local = $end_time_utc->setTimezone($site_tz);
      $slot_end = new \DateTime($date_value . ' ' . $end_time_local->format('H:i:s'), $site_tz);
    }
    catch (\Exception $e) {
      continue;
    }

    // Compare with now + 8h lag.
    $cutoff = clone $now;
    $cutoff->modify('-8 hours');

    if ($slot_end < $cutoff) {
      $order_item->set('field_swim_test_status', 'no_show');
      $order_item->save();
      $flipped++;

      \Drupal::logger('picc_registration')->notice('Auto-flipped swim test order item @oid to no_show (slot ended @end).', [
        '@oid' => $order_item->id(),
        '@end' => $slot_end->format('c'),
      ]);
    }
  }

  if ($flipped > 0) {
    \Drupal::logger('picc_registration')->notice('Auto no-show sweep: flipped @count registration(s).', [
      '@count' => $flipped,
    ]);
  }
}

/**
 * Implements hook_workflows_alter().
 *
 * Adds a "completed → canceled" transition to the default order workflow
 * so that completed orders can be canceled (e.g. after issuing a refund).
 * Commerce Stock will automatically return inventory on cancellation.
 */
function picc_registration_workflows_alter(array &$workflows) {
  if (isset($workflows['order_default'])) {
    $workflows['order_default']['transitions']['cancel']['from'][] = 'completed';
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for commerce_order_item.
 *
 * Ensures order item titles include participant names when displayed.
 */
function picc_registration_commerce_order_item_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  // Only process activity_registration order items
  if ($entity->bundle() !== 'activity_registration') {
    return;
  }

  // Check if participant name is already in title
  $current_title = $entity->getTitle();
  if (strpos($current_title, ' - ') !== FALSE) {
    // Title already has participant name
    return;
  }

  // Get participant profile
  $participant_id = $entity->get('field_participant')->target_id;
  if (!$participant_id) {
    return;
  }

  $profile = \Drupal\profile\Entity\Profile::load($participant_id);
  if (!$profile) {
    return;
  }

  // Build name
  $name_field = $profile->get('field_name')->first();
  $name = $name_field ? trim(($name_field->given ?? '') . ' ' . ($name_field->family ?? '')) : 'Participant';

  // Update title for display
  $variation_title = $entity->getPurchasedEntity()->getTitle();
  $new_title = $variation_title . ' - ' . $name;

  // Override the title in the render array
  if (isset($build['title'])) {
    $build['title']['#markup'] = $new_title;
  }
}

/**
 * Implements hook_form_alter().
 *
 * Pre-populates billing address on checkout from user's profile address.
 */
function picc_registration_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Swim test registration: disable checkboxes for passed/exempt AND
  // for participants already registered for a future swim test.
  if ($form_id === 'webform_submission_swim_test_registration_add_form') {
    if (isset($form['elements']['participants'])) {
      $form['elements']['participants']['#after_build'][] = '_picc_registration_disable_cleared_participants';
      $form['elements']['participants']['#after_build'][] = '_picc_registration_disable_future_swim_registered';
    }
    return;
  }

  // Swim attestation: disable checkboxes for already attested/passed/exempt.
  if ($form_id === 'webform_submission_swim_attestation_add_form') {
    // Check up-front whether this user has any actionable participants.
    // If not, swap in a friendly message and lift the required flags so
    // validation won't complain about empty fields.
    _picc_registration_attestation_check_actionable($form);
    if (isset($form['elements']['participants'])) {
      $form['elements']['participants']['#after_build'][] = '_picc_registration_disable_cleared_participants';
    }
    return;
  }

  // Only act on commerce checkout forms
  if (strpos($form_id, 'commerce_checkout_flow_') !== 0) {
    return;
  }

  // Debug: Log that we're in a checkout form
  \Drupal::logger('picc_registration')->notice('Processing checkout form: @form_id', ['@form_id' => $form_id]);

  // Only populate on the order (checkout) step that has billing info
  if (!isset($form['payment_information']) || !isset($form['payment_information']['billing_information'])) {
    \Drupal::logger('picc_registration')->notice('No payment_information or billing_information found in form');
    return;
  }

  $current_user = \Drupal::currentUser();
  if (!$current_user->isAuthenticated()) {
    \Drupal::logger('picc_registration')->notice('User not authenticated');
    return;
  }

  // Load user account
  $user = \Drupal\user\Entity\User::load($current_user->id());
  if (!$user) {
    \Drupal::logger('picc_registration')->notice('Could not load user');
    return;
  }

  // Check if user has field_address on their profile
  if (!$user->hasField('field_address') || $user->get('field_address')->isEmpty()) {
    \Drupal::logger('picc_registration')->notice('User does not have field_address or it is empty');
    return;
  }

  // Get the user's address
  $user_address = $user->get('field_address')->first();
  if (!$user_address) {
    \Drupal::logger('picc_registration')->notice('Could not get user address value');
    return;
  }

  // Get address values as array
  $address_values = $user_address->getValue();

  // Get user's name from field_name if available
  $given_name = '';
  $family_name = '';

  if ($user->hasField('field_name') && !$user->get('field_name')->isEmpty()) {
    $name_field = $user->get('field_name')->first();
    if ($name_field) {
      $name_values = $name_field->getValue();

      // Debug: log what getValue actually returns
      \Drupal::logger('picc_registration')->notice('Name field getValue: @values', [
        '@values' => print_r($name_values, TRUE)
      ]);

      $given_name = $name_values['given'] ?? '';
      $family_name = $name_values['family'] ?? '';
    }
  }

  \Drupal::logger('picc_registration')->notice('Found user address, attempting to pre-populate. Address data: @data, Name: @given @family', [
    '@data' => print_r($address_values, TRUE),
    '@given' => $given_name,
    '@family' => $family_name,
  ]);

  // Get billing address field
  $billing_info = &$form['payment_information']['billing_information'];

  // Check if address is already filled with actual data
  $existing_default = $billing_info['address']['widget'][0]['address']['#default_value'] ?? [];
  $has_real_data = !empty($existing_default['address_line1']) || !empty($existing_default['locality']);

  if ($has_real_data) {
    \Drupal::logger('picc_registration')->notice('Billing address already has real data, skipping pre-fill');
    return;
  }

  // Pre-populate billing address with user's profile address
  if (isset($billing_info['address']['widget'][0]['address'])) {
    $address_field = &$billing_info['address']['widget'][0]['address'];

    // Map user address to billing address using getValue() array
    $address_field['#default_value'] = [
      'country_code' => $address_values['country_code'] ?? 'CA',
      'administrative_area' => $address_values['administrative_area'] ?? '',
      'locality' => $address_values['locality'] ?? '',
      'postal_code' => $address_values['postal_code'] ?? '',
      'address_line1' => $address_values['address_line1'] ?? '',
      'address_line2' => $address_values['address_line2'] ?? '',
      'organization' => $address_values['organization'] ?? '',
      'given_name' => $given_name ?: ($address_values['given_name'] ?? ''),
      'family_name' => $family_name ?: ($address_values['family_name'] ?? ''),
    ];

    \Drupal::logger('picc_registration')->notice('Successfully set billing address default values');
  } else {
    \Drupal::logger('picc_registration')->notice('Could not find address field in expected location');

    // Debug: log the actual structure
    \Drupal::logger('picc_registration')->notice('Billing info keys: @keys', [
      '@keys' => implode(', ', array_keys($billing_info))
    ]);
  }
}

/**
 * Implements hook_form_alter() for cart form.
 *
 * Customizes the cart page to remove "Update cart" and add "Register for more" link.
 */
function picc_registration_form_views_form_commerce_cart_form_default_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Remove the "Update cart" button - not needed since quantities are fixed at 1
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#access'] = FALSE;
  }

  // Add "Register for more activities" link
  $form['actions']['register_more'] = [
    '#type' => 'link',
    '#title' => t('Register for more activities'),
    '#url' => \Drupal\Core\Url::fromUserInput('/program'),
    '#attributes' => [
      'class' => ['btn', 'my-3', 'btn-secondary'],
    ],
    '#weight' => -10,
  ];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for commerce_product.
 *
 * Auto-assigns default store to products that don't have a store selected.
 */
function picc_registration_commerce_product_presave(EntityInterface $product) {
  // Auto-assign default store if none selected
  if ($product->get('stores')->isEmpty()) {
    $store_storage = \Drupal::entityTypeManager()->getStorage('commerce_store');
    $stores = $store_storage->loadByProperties(['is_default' => TRUE]);
    if (!empty($stores)) {
      $default_store = reset($stores);
      $product->set('stores', $default_store);
      \Drupal::logger('picc_registration')->notice('Auto-assigned default store to product @title', [
        '@title' => $product->label(),
      ]);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for commerce_product_variation.
 *
 * Forces swim_test_slot variations to $0 CAD. The price field is hidden
 * from the admin form so this guarantees every swim test slot has a
 * valid price in the database.
 */
function picc_registration_commerce_product_variation_presave(EntityInterface $variation) {
  if ($variation->bundle() !== 'swim_test_slot') {
    return;
  }
  $variation->setPrice(new \Drupal\commerce_price\Price('0', 'CAD'));
}

/**
 * After-build callback: disables checkboxes for passed/exempt participants.
 */
function _picc_registration_disable_cleared_participants($element, FormStateInterface $form_state) {
  $cleared_statuses = ['passed', 'attested', 'exempt'];

  foreach (\Drupal\Core\Render\Element::children($element) as $key) {
    $profile = \Drupal\profile\Entity\Profile::load($key);
    if (!$profile || !$profile->hasField('field_swim_status')) {
      continue;
    }

    $swim_status = $profile->get('field_swim_status')->value ?? 'none';
    if (in_array($swim_status, $cleared_statuses)) {
      $element[$key]['#attributes']['disabled'] = 'disabled';
      $element[$key]['#attributes']['class'][] = 'opacity-50';
      $element[$key]['#wrapper_attributes']['class'][] = 'opacity-50';
    }
  }

  return $element;
}

/**
 * Checks whether the current user has any actionable adult family members
 * for the swim attestation form. If not, replaces the form with a friendly
 * message and lifts required flags so validation doesn't complain.
 *
 * Runs in hook_form_alter (before validation), not in after_build.
 *
 * @param array $form
 *   The form render array, modified by reference.
 */
function _picc_registration_attestation_check_actionable(array &$form) {
  $uid = (int) \Drupal::currentUser()->id();
  if (!$uid) {
    return;
  }

  // Cutoff for "15 or older as of Dec 31 this year": born on or before this date.
  $cutoff_date = (date('Y') - 15) . '-12-31';

  // Load this user's participant profiles that are 15+.
  $profile_storage = \Drupal::entityTypeManager()->getStorage('profile');
  $ids = $profile_storage->getQuery()
    ->condition('type', 'participant')
    ->condition('status', 1)
    ->condition('uid', $uid)
    ->condition('field_birth_date', $cutoff_date, '<=')
    ->accessCheck(FALSE)
    ->execute();

  $cleared = ['passed', 'attested', 'exempt'];
  $has_any = FALSE;
  $has_actionable = FALSE;

  foreach ($profile_storage->loadMultiple($ids) as $profile) {
    if (!$profile->get('field_birth_date')->value) {
      continue;
    }
    $has_any = TRUE;
    $status = $profile->get('field_swim_status')->value ?? 'none';
    if (!in_array($status, $cleared, TRUE)) {
      $has_actionable = TRUE;
      break;
    }
  }

  if ($has_actionable) {
    return;
  }

  // Nothing to do — swap in a friendly message.
  if ($has_any) {
    $heading = t('You\'re all set.');
    $body = t('All eligible family members already have a current swim attestation or passed swim test on file. Nothing to do here.');
  }
  else {
    $heading = t('Nothing to attest.');
    $body = t('You have no family members 15 or older in your account. If you need to add someone, use the link below to edit your family members.');
  }

  $form['all_done_message'] = [
    '#markup' => '<div class="alert alert-success my-4 p-4 rounded"><p class="font-semibold">' . $heading . '</p><p>' . $body . '</p></div>',
    '#weight' => -100,
  ];

  // Remove required flag and hide the inputs so validation won't fail.
  if (isset($form['elements']['participants'])) {
    $form['elements']['participants']['#required'] = FALSE;
    $form['elements']['participants']['#access'] = FALSE;
  }
  if (isset($form['elements']['attestation_agreement'])) {
    $form['elements']['attestation_agreement']['#required'] = FALSE;
    $form['elements']['attestation_agreement']['#access'] = FALSE;
  }
  if (isset($form['actions'])) {
    $form['actions']['#access'] = FALSE;
  }
}

/**
 * After-build callback: disables checkboxes for participants already
 * registered for a future swim test (strictly after today).
 */
function _picc_registration_disable_future_swim_registered($element, FormStateInterface $form_state) {
  $order_item_storage = \Drupal::entityTypeManager()->getStorage('commerce_order_item');
  $date_formatter = \Drupal::service('date.formatter');
  $today = new \DateTime('today');
  $site_tz = new \DateTimeZone(date_default_timezone_get());

  foreach (\Drupal\Core\Render\Element::children($element) as $key) {
    // Skip if already disabled by the cleared-participants callback.
    if (!empty($element[$key]['#attributes']['disabled'])) {
      continue;
    }

    // Look for existing swim test registrations for this participant.
    $order_item_ids = $order_item_storage->getQuery()
      ->condition('type', 'swim_test_registration')
      ->condition('field_participant', $key)
      ->accessCheck(FALSE)
      ->execute();

    if (empty($order_item_ids)) {
      continue;
    }

    $future_info = NULL;
    foreach ($order_item_storage->loadMultiple($order_item_ids) as $order_item) {
      $order = $order_item->getOrder();
      if (!$order || !in_array($order->getState()->getId(), ['completed', 'fulfillment'])) {
        continue;
      }

      $variation = $order_item->getPurchasedEntity();
      if (!$variation || !$variation->hasField('field_date')) {
        continue;
      }

      $date_value = $variation->get('field_date')->value;
      if (!$date_value) {
        continue;
      }

      $slot_date = new \DateTime($date_value);
      $status = $order_item->get('field_swim_test_status')->value ?? 'pending';
      if ($slot_date >= $today && $status === 'pending') {
        // Use date.formatter for locale-aware date rendering.
        $date_str = $date_formatter->format($slot_date->getTimestamp(), 'custom', 'F j, Y', $site_tz->getName());
        $time_str = '';
        if ($variation->hasField('field_time_range') && !$variation->get('field_time_range')->isEmpty()) {
          $start_value = $variation->get('field_time_range')->value;
          $end_value = $variation->get('field_time_range')->end_value;
          $start_ts = (new \DateTime($start_value, new \DateTimeZone('UTC')))->getTimestamp();
          $start_time = $date_formatter->format($start_ts, 'custom', 'g:i A', $site_tz->getName());
          $end_time = '';
          if ($end_value) {
            $end_ts = (new \DateTime($end_value, new \DateTimeZone('UTC')))->getTimestamp();
            $end_time = $date_formatter->format($end_ts, 'custom', 'g:i A', $site_tz->getName());
          }
          $time_str = $end_time ? " $start_time - $end_time" : " $start_time";
        }
        $future_info = $date_str . $time_str;
        break;
      }
    }

    if ($future_info) {
      // Get participant name from the profile to rebuild the label.
      $profile = \Drupal\profile\Entity\Profile::load($key);
      $name = '';
      if ($profile) {
        $name_field = $profile->get('field_name')->first();
        if ($name_field) {
          $name = trim(($name_field->given ?? '') . ' ' . ($name_field->family ?? ''));
        }
      }
      $message = t('Already registered for swim test on @date', ['@date' => $future_info]);
      $element[$key]['#attributes']['disabled'] = 'disabled';
      $element[$key]['#attributes']['class'][] = 'opacity-50';
      $element[$key]['#attributes']['title'] = $message;
      $element[$key]['#wrapper_attributes']['class'][] = 'opacity-50';
      $element[$key]['#wrapper_attributes']['title'] = $message;
      // Replace the label so the "already registered" note sits right after the name.
      $label = \Drupal\Core\Render\Markup::create(
        htmlspecialchars($name) . ' <span class="text-sm italic opacity-75">(' . $message . ')</span>'
      );
      $element[$key]['#title'] = $label;
    }
  }

  return $element;
}

/**
 * Implements hook_views_post_execute().
 *
 * Prefetches remaining-stock totals and completed-registration counts for all
 * variations rendered by the variant_session view in one query each, then
 * stores per-variation status in a static cache for the row preprocess to
 * read. This avoids N per-row DB hits when a product has many sessions.
 */
function picc_registration_views_post_execute(ViewExecutable $view) {
  if ($view->id() !== 'variant_session') {
    return;
  }

  $variation_ids = [];
  foreach ($view->result as $row) {
    if (!empty($row->_entity) && $row->_entity->getEntityTypeId() === 'commerce_product_variation') {
      $variation_ids[] = (int) $row->_entity->id();
    }
  }

  if (empty($variation_ids)) {
    return;
  }

  $connection = \Drupal::database();

  // Remaining stock per variation = SUM(commerce_stock_transaction.qty).
  // Untracked bundles (always_in_stock) have no transactions; they fall
  // through to the "no entry" branch below and end up as 'available'.
  $stock_query = $connection->select('commerce_stock_transaction', 'st')
    ->fields('st', ['entity_id'])
    ->condition('st.entity_type', 'commerce_product_variation')
    ->condition('st.entity_id', $variation_ids, 'IN')
    ->groupBy('st.entity_id');
  $stock_query->addExpression('SUM(st.qty)', 'total');
  $stock_totals = $stock_query->execute()->fetchAllKeyed(0, 1);

  // Completed/fulfilled registration counts per variation.
  $reg_query = $connection->select('commerce_order_item', 'oi');
  $reg_query->join('commerce_order__order_items', 'ooi', 'ooi.order_items_target_id = oi.order_item_id');
  $reg_query->join('commerce_order', 'o', 'o.order_id = ooi.entity_id');
  $reg_query->fields('oi', ['purchased_entity']);
  $reg_query->condition('oi.type', ['activity_registration', 'swim_test_registration'], 'IN');
  $reg_query->condition('oi.purchased_entity', $variation_ids, 'IN');
  $reg_query->condition('o.state', ['completed', 'fulfillment'], 'IN');
  $reg_query->groupBy('oi.purchased_entity');
  $reg_query->addExpression('COUNT(oi.order_item_id)', 'cnt');
  $reg_counts = $reg_query->execute()->fetchAllKeyed(0, 1);

  $cache = &drupal_static('picc_registration_session_status', []);
  foreach ($variation_ids as $vid) {
    $has_stock_record = array_key_exists($vid, $stock_totals);
    $stock = $has_stock_record ? (int) $stock_totals[$vid] : 0;
    $registrations = isset($reg_counts[$vid]) ? (int) $reg_counts[$vid] : 0;

    if (!$has_stock_record) {
      // Untracked bundle (always_in_stock) — treat as available.
      $status = 'available';
      $spots = NULL;
    }
    elseif ($stock <= 0) {
      $status = 'full';
      $spots = 0;
    }
    elseif ($stock <= PICC_REGISTRATION_LOW_STOCK_THRESHOLD) {
      $status = 'low';
      $spots = $stock;
    }
    else {
      $status = 'available';
      $spots = $stock;
    }

    $cache[$vid] = [
      'status' => $status,
      'spots_remaining' => $spots,
      'registrations' => $registrations,
    ];
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 *
 * Injects the variation bundle (machine name) into the template as
 * $variables['variation_bundle'] for the variant_session view, plus the
 * registration status and spots-remaining computed in views_post_execute.
 */
function picc_registration_preprocess_views_view_fields(&$variables) {
  $view = $variables['view'];
  if ($view->id() !== 'variant_session') {
    return;
  }

  $row = $variables['row'];
  if (!empty($row->_entity) && $row->_entity->getEntityTypeId() === 'commerce_product_variation') {
    $variation = $row->_entity;
    $variables['variation_bundle'] = $variation->bundle();

    $cache = &drupal_static('picc_registration_session_status', []);
    $info = $cache[(int) $variation->id()] ?? [
      'status' => 'available',
      'spots_remaining' => NULL,
      'registrations' => 0,
    ];
    $variables['registration_status'] = $info['status'];
    $variables['spots_remaining'] = $info['spots_remaining'];
  }
  else {
    $variables['variation_bundle'] = '';
    $variables['registration_status'] = 'available';
    $variables['spots_remaining'] = NULL;
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * - participants view: dynamic birth-date filter (under-15 / 15+) on the
 *   webform er_swim_participants and er_attestation_participants displays.
 * - swim_test_roster view (profile-based): under-15 cutoff plus rewrites
 *   the entity_reverse relationship's JOIN to commerce_order_item so it
 *   only matches PENDING swim_test_registration order items on completed
 *   orders. Profiles with no matching pending registration become
 *   walk-ups (NULL on the joined columns). Also restricts the variation
 *   data join to the source-language row so FR-translated slots don't
 *   duplicate rows.
 */
function picc_registration_views_query_alter($view, $query) {
  $current_year = (int) date('Y');
  $cutoff_date = ($current_year - 15) . '-12-31';

  if ($view->id() === 'participants') {
    if ($view->current_display === 'er_swim_participants') {
      $query->addWhere(0, 'profile__field_birth_date.field_birth_date_value', $cutoff_date, '>');
    }
    elseif ($view->current_display === 'er_attestation_participants') {
      $query->addWhere(0, 'profile__field_birth_date.field_birth_date_value', $cutoff_date, '<=');
    }
    return;
  }

  if ($view->id() !== 'swim_test_roster') {
    return;
  }

  // Under-15 cutoff for the swim test roster.
  $query->addWhere(0, 'profile__field_birth_date.field_birth_date_value', $cutoff_date, '>');

  // Constrain the entity_reverse relationship's joins so only pending
  // swim_test_registration rows on completed/fulfillment orders match.
  // Putting these in the JOIN ON clauses (instead of WHERE) keeps the
  // joins LEFT — profiles with no match still come through as walk-ups
  // with NULL variant fields.
  $table_queue = &$query->getTableQueue();
  if (empty($table_queue)) {
    return;
  }
  $field_date_alias = NULL;
  foreach ($table_queue as $a => &$info) {
    $table = $info['table'] ?? '';
    // Field_participant join (first hop of the reverse reference): constrain
    // to the swim_test_registration bundle so paddle-camp registrations
    // don't double rows.
    if ($table === 'commerce_order_item__field_participant'
        && isset($info['join']) && is_array($info['join']->extra)) {
      $info['join']->extra[] = ['field' => 'bundle', 'value' => 'swim_test_registration'];
      continue;
    }
    // Order_item entity join (second hop): constrain by type, status
    // (via EXISTS subquery on the status field table), and order state.
    if ($table === 'commerce_order_item' && isset($info['join'])) {
      $oi = $info['alias'];
      $info['join']->extra = "{$oi}.type = 'swim_test_registration'"
        . " AND EXISTS (SELECT 1 FROM {commerce_order_item__field_swim_test_status} _sts WHERE _sts.entity_id = {$oi}.order_item_id AND _sts.field_swim_test_status_value = 'pending')"
        . " AND EXISTS (SELECT 1 FROM {commerce_order} _o WHERE _o.order_id = {$oi}.order_id AND _o.state IN ('completed', 'fulfillment'))";
      continue;
    }
    // Variation data join: restrict to the source-language row. The
    // swim_test_slot bundle is translatable (for the description field),
    // so a slot with a FR translation has two rows in
    // commerce_product_variation_field_data — without this predicate the
    // join doubles every registered participant. In the ON clause (not
    // WHERE) so walk-ups still pass through as NULL.
    if ($table === 'commerce_product_variation_field_data' && isset($info['join'])) {
      if (!is_array($info['join']->extra)) {
        $info['join']->extra = [];
      }
      $info['join']->extra[] = ['field' => 'default_langcode', 'value' => 1];
      continue;
    }
    // Track the variation date field table so we can prepend a NULL-last
    // sort below.
    if ($table === 'commerce_product_variation__field_date') {
      $field_date_alias = $a;
    }
  }
  unset($info);

  // Stash the field-date alias so the query-tag alter below can prepend an
  // "IS NULL" expression to ORDER BY (walk-ups at the bottom). We can't add
  // it via $query->orderby here — Drupal's escapeField mangles formulas.
  if ($field_date_alias) {
    $query->options['picc_swim_field_date_alias'] = $field_date_alias;
  }
}

/**
 * Implements hook_query_TAG_alter() for the swim_test_roster view.
 *
 * Prepends a "field_date IS NULL" sort to ORDER BY so walk-ups (rows where
 * the joined variant date is NULL) cluster at the bottom of the page. Done
 * here rather than in views_query_alter because Views' Sql::query()
 * pipes orderby fields through escapeField, which mangles formulas.
 */
function picc_registration_query_views_swim_test_roster_alter($query) {
  $view = $query->getMetaData('view');
  $views_query = $view ? $view->query : NULL;
  $alias = $views_query->options['picc_swim_field_date_alias'] ?? NULL;
  if (!$alias) {
    return;
  }
  // Add the CASE expression as a SELECT field; orderBy by its alias.
  $expr_alias = $query->addExpression(
    "CASE WHEN {$alias}.field_date_value IS NULL THEN 1 ELSE 0 END",
    'picc_swim_walk_up_last'
  );
  $query->orderBy($expr_alias, 'ASC');
  // Reorder $order so this sort comes first. Use reflection because the
  // property is protected; this is a known pattern in Drupal contrib.
  $reflection = new \ReflectionProperty($query, 'order');
  $order = $reflection->getValue($query);
  if (isset($order[$expr_alias])) {
    $value = $order[$expr_alias];
    unset($order[$expr_alias]);
    $order = [$expr_alias => $value] + $order;
    $reflection->setValue($query, $order);
  }
}

/**
 * Implements hook_webform_submission_validate().
 * Prevent registering for past sessions
 */
function picc_registration_webform_submission_validate(array &$form, FormStateInterface $form_state, WebformSubmissionInterface $webform_submission) {
  // Log at the very start - before ANY conditions
  \Drupal::logger('picc_registration')->notice('VALIDATION HOOK FIRED!');

  \Drupal::logger('picc_registration')->notice('Webform validation hook fired for: @webform', [
    '@webform' => $webform_submission->getWebform()->id(),
  ]);

  if ($webform_submission->getWebform()->id() == 'program_registration') {
    $variation_id = \Drupal::request()->query->get('variation');

    \Drupal::logger('picc_registration')->notice('Variation ID from URL: @id', [
      '@id' => $variation_id ?? 'NULL',
    ]);

    if ($variation_id) {
      $variation = \Drupal::entityTypeManager()
        ->getStorage('commerce_product_variation')
        ->load($variation_id);

      if ($variation && $variation->hasField('field_date_range')) {
        $date_range = $variation->get('field_date_range')->first();
        if ($date_range) {
          $end_date = new DrupalDateTime($date_range->end_value);
          $now = new DrupalDateTime('now');

          \Drupal::logger('picc_registration')->notice('End date: @end, Now: @now', [
            '@end' => $end_date->format('Y-m-d H:i:s'),
            '@now' => $now->format('Y-m-d H:i:s'),
          ]);

          if ($end_date < $now) {
            $form_state->setErrorByName('', t('This session has already ended. Please select a different session.'));
          }
        }
      }
    }
  }
}

/**
 * Implements hook_token_info().
 */
function picc_registration_token_info() {
  $info = [];

  $info['tokens']['commerce_order']['order_items_formatted'] = [
    'name' => t('Order items (formatted with participants)'),
    'description' => t('Lists order items with participant names, one per line.'),
  ];

  return $info;
}

/**
 * Implements hook_tokens().
 */
function picc_registration_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];

  if ($type == 'commerce_order' && !empty($data['commerce_order'])) {
    /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
    $order = $data['commerce_order'];

    foreach ($tokens as $name => $original) {
      switch ($name) {
        case 'order_items_formatted':
          $items = [];
          foreach ($order->getItems() as $order_item) {
            $title = $order_item->getTitle();

            // Get participant name if available.
            $participant_name = '';
            if ($order_item->hasField('field_participant') && !$order_item->get('field_participant')->isEmpty()) {
              /** @var \Drupal\profile\Entity\ProfileInterface $profile */
              $profile = $order_item->get('field_participant')->entity;
              if ($profile && $profile->hasField('field_name') && !$profile->get('field_name')->isEmpty()) {
                // Get the formatted name from the Name field.
                $name_field = $profile->get('field_name')->first();
                if ($name_field) {
                  $given = $name_field->given ?? '';
                  $family = $name_field->family ?? '';
                  $participant_name = trim($given . ' ' . $family);
                }
              }
            }

            // Format: "Participant Name: Program Title" or just "Program Title".
            // Skip prepending the name if the title already ends with it
            // (swim test handler appends "- Name" to the title).
            if (!empty($participant_name) && !str_ends_with($title, '- ' . $participant_name)) {
              $items[] = '<strong>' . htmlspecialchars($participant_name) . '</strong>: ' . htmlspecialchars($title);
            }
            else {
              $items[] = htmlspecialchars($title);
            }
          }

          // Join with line breaks and mark as safe HTML.
          $replacements[$original] = Markup::create(implode('<br>', $items));
          break;
      }
    }
  }

  return $replacements;
}
