<?php

/**
 * Implements hook_preprocess_field().
 *
 * - Adds prose class to field_coach_lang
 * - Injects hero variables for commerce_product:activity title field
 * - Builds subtitle per UI language using translated labels from Drupal
 * - Finds hero image on product OR default variation (File or Media)
 */
function daisyui_ext_preprocess_field(array &$variables): void {
  $element = $variables['element'] ?? [];
  $field_name = $element['#field_name'] ?? '';

  // Add prose class to coach language field.
  if ($field_name === 'field_coach_lang') {
    $variables['attributes']['class'][] = 'prose';
  }

  // Only continue for product title hero.
  if (
    ($element['#entity_type'] ?? NULL) !== 'commerce_product' ||
    ($element['#bundle'] ?? NULL) !== 'activity' ||
    $field_name !== 'title'
  ) {
    return;
  }

  /** @var \Drupal\commerce_product\Entity\ProductInterface|null $product */
  $product = $element['#object'] ?? NULL;
  if (!$product) {
    return;
  }

  // UI language (you said this is 'fr' for French).
  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(\Drupal\Core\Language\LanguageInterface::TYPE_INTERFACE)
    ->getId();

  $is_fr = ($langcode === 'fr');

  /** @var \Drupal\Core\Entity\EntityRepositoryInterface $repo */
  $repo = \Drupal::service('entity.repository');

  // Get product translation from context (so labels resolve in current UI lang).
  $product = $repo->getTranslationFromContext($product, $langcode);

  // Title.
  $variables['product_title'] = $product->label();

  // Audience label (from allowed values). These labels MUST be translated via config translation.
  $variables['audience_label'] = '';
  if ($product->hasField('field_audience') && !$product->get('field_audience')->isEmpty()) {
    $raw = (string) $product->get('field_audience')->value;
    $allowed = $product->getFieldDefinition('field_audience')->getSetting('allowed_values') ?? [];
    $variables['audience_label'] = $allowed[$raw] ?? $raw;
  }

  // Activity type label (taxonomy term). Term must be translated; we also pull translation from context.
  $variables['activity_type_label'] = '';
  foreach (['field_activity_type', 'field_acivity_type'] as $fname) {
    if ($product->hasField($fname) && !$product->get($fname)->isEmpty()) {
      $term = $product->get($fname)->entity;
      if ($term) {
        $term = $repo->getTranslationFromContext($term, $langcode);
        $variables['activity_type_label'] = $term->label();
      }
      break;
    }
  }

  // Hero image: try product first, then default variation (common in Commerce).
  $variables['hero_image_url'] = '';
  $image_entity = NULL;

  if ($product->hasField('field_primary_image') && !$product->get('field_primary_image')->isEmpty()) {
    $image_entity = $product->get('field_primary_image')->entity;
  }

  if (!$image_entity && method_exists($product, 'getDefaultVariation')) {
    $variation = $product->getDefaultVariation();
    if ($variation) {
      $variation = $repo->getTranslationFromContext($variation, $langcode);
      if ($variation->hasField('field_primary_image') && !$variation->get('field_primary_image')->isEmpty()) {
        $image_entity = $variation->get('field_primary_image')->entity;
      }
    }
  }

  // Resolve File from File or Media.
  if ($image_entity) {
    $file = NULL;

    if ($image_entity instanceof \Drupal\file\FileInterface) {
      $file = $image_entity;
    }
    elseif ($image_entity instanceof \Drupal\media\MediaInterface) {
      $image_entity = $repo->getTranslationFromContext($image_entity, $langcode);
      foreach (['field_media_image', 'image', 'field_image'] as $media_field) {
        if ($image_entity->hasField($media_field) && !$image_entity->get($media_field)->isEmpty()) {
          $file = $image_entity->get($media_field)->entity;
          if ($file instanceof \Drupal\file\FileInterface) {
            break;
          }
          $file = NULL;
        }
      }
    }

    if ($file instanceof \Drupal\file\FileInterface) {
      $uri = $file->getFileUri();
      $style = \Drupal\image\Entity\ImageStyle::load('max_1300x1300');
      $variables['hero_image_url'] = $style ? $style->buildUrl($uri) : file_create_url($uri);
    }
  }

  // Subtitle assembly ONLY (no translation mapping).
  $audience = trim((string) $variables['audience_label']);
  $program_type = trim((string) $variables['activity_type_label']);

  if ($is_fr) {
    // FR: program type then audience.
    $variables['subtitle'] = trim(implode(' ', array_filter([$program_type, $audience])));
  }
  else {
    // EN: audience then program type (lowercase program type for style, if desired).
    $variables['subtitle'] = trim(implode(' ', array_filter([$audience, $program_type ? strtolower($program_type) : ''])));
  }
}
