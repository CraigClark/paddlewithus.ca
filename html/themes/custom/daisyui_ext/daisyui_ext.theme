<?php

/**
 * @file
 * Functions to support theming in the UI Suite DaisyUI theme.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\file\Entity\File;
use Drupal\image\Entity\ImageStyle;
use Drupal\file\FileInterface;
use Drupal\media\MediaInterface;

/**
 * Implements hook_form_alter().
 * Disables HTML5 validation so Drupal handles all validation.
 * Adds error summary at top of forms with validation errors.
 */
function daisyui_ext_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $form['#attributes']['novalidate'] = 'novalidate';

  $real_form_id = $form['#form_id'] ?? '';
  if ($real_form_id === 'profile_participant_add_form' || $real_form_id === 'profile_participant_edit_form') {
    _daisyui_ext_participant_contact_labels($form);
  }

  $errors = $form_state->getErrors();
  if (empty($errors)) {
    return;
  }

  $error_summary = [
    '#type' => 'container',
    '#weight' => -1000,
    '#attributes' => [
      'class' => ['alert', 'alert-error', 'mb-6'],
      'role' => 'alert',
    ],
  ];

  $error_summary['heading'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#attributes' => ['class' => ['font-bold', 'text-lg', 'mb-2']],
    '#value' => t('Error message'),
  ];

  $error_summary['message'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#value' => \Drupal::translation()->formatPlural(
      count($errors),
      '1 error has been found:',
      '@count errors have been found:'
    ),
  ];

  $items = [];
  foreach ($errors as $name => $error) {
    $field_id = 'edit-' . str_replace(['[', ']'], ['-', ''], (string) $name);
    $items[] = [
      '#type' => 'html_tag',
      '#tag' => 'a',
      '#attributes' => [
        'href' => '#' . $field_id,
        'class' => ['underline'],
      ],
      '#value' => $error,
    ];
  }

  $error_summary['list'] = [
    '#theme' => 'item_list',
    '#items' => $items,
    '#attributes' => ['class' => ['mt-2', 'space-y-1']],
  ];

  $form['error_summary'] = $error_summary;
}

/**
 * Implements hook_preprocess_form_element().
 */
function daisyui_ext_preprocess_form_element(array &$variables): void {
  if (!empty($variables['element']['#errors'])) {
    if (isset($variables['label']['#attributes']['class'])) {
      $variables['label']['#attributes']['class'][] = 'text-error';
      $variables['label']['#attributes']['class'][] = 'font-semibold';
    }
  }
}

/**
 * Implements hook_preprocess_input().
 */
function daisyui_ext_preprocess_input(array &$variables): void {
  if (!empty($variables['element']['#errors'])) {
    $variables['attributes']['class'][] = 'border-error';
    $variables['attributes']['class'][] = 'border-2';
  }
}

/**
 * Implements hook_preprocess_textarea().
 */
function daisyui_ext_preprocess_textarea(array &$variables): void {
  if (!empty($variables['element']['#errors'])) {
    $variables['attributes']['class'][] = 'border-error';
    $variables['attributes']['class'][] = 'border-2';
  }
}

/**
 * Implements hook_preprocess_select().
 */
function daisyui_ext_preprocess_select(array &$variables): void {
  if (!empty($variables['element']['#errors'])) {
    $variables['attributes']['class'][] = 'border-error';
    $variables['attributes']['class'][] = 'border-2';
  }
}

/**
 * Implements hook_theme_suggestions_form_alter().
 */
function daisyui_ext_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $form_id = $variables['element']['#form_id'] ?? NULL;

  if ($form_id === 'profile_participant_add_form' || $form_id === 'profile_participant_edit_form') {
    $suggestions[] = 'form__profile_participant';
  }
}

/**
 * Rename emergency contact field labels.
 */
function _daisyui_ext_participant_contact_labels(array &$form): void {
  $map = [
    'field_emercency_contact_1_name'  => 'Name',
    'field_emercency_contact_1_phone' => 'Phone',
    'field_emercency_contact_1_rel'   => 'Relationship',

    'field_emercency_contact_2_name'  => 'Name',
    'field_emercency_contact_2_phone' => 'Phone',
    'field_emercency_contact_2_rel'   => 'Relationship',

    'field_emercency_contact_3_name'  => 'Name',
    'field_emercency_contact_3_phone' => 'Phone',
    'field_emercency_contact_3_rel'   => 'Relationship',
  ];

  foreach ($map as $field_key => $title) {
    if (!isset($form[$field_key])) {
      continue;
    }

    if (isset($form[$field_key]['widget'][0]['value']['#title'])) {
      $form[$field_key]['widget'][0]['value']['#title'] = t($title);
      continue;
    }

    if (isset($form[$field_key]['#title'])) {
      $form[$field_key]['#title'] = t($title);
      continue;
    }

    if (isset($form[$field_key]['widget'][0]) && is_array($form[$field_key]['widget'][0])) {
      foreach ($form[$field_key]['widget'][0] as $child_key => $child) {
        if (is_array($child) && isset($form[$field_key]['widget'][0][$child_key]['#title'])) {
          $form[$field_key]['widget'][0][$child_key]['#title'] = t($title);
          break;
        }
      }
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the cart form.
 */
function daisyui_ext_form_views_form_commerce_cart_form_default_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id
): void {
  if (isset($form['actions']['checkout'])) {
    $form['actions']['checkout']['#attributes']['class'] = ['btn', 'btn-primary', 'my-3'];
  }
}

/**
 * Implements hook_preprocess_field().
 *
 * - Adds prose class to field_coach_lang
 * - Injects hero variables for commerce_product:activity title field
 */
function daisyui_ext_preprocess_field(array &$variables): void {
  $element = $variables['element'] ?? [];
  $field_name = $element['#field_name'] ?? '';

  // Add prose class to coach language field.
  if ($field_name === 'field_coach_lang') {
    $variables['attributes']['class'][] = 'prose';
  }

  // Only continue for product title hero.
  if (
    ($element['#entity_type'] ?? NULL) !== 'commerce_product' ||
    ($element['#bundle'] ?? NULL) !== 'activity' ||
    $field_name !== 'title'
  ) {
    return;
  }

  /** @var \Drupal\commerce_product\Entity\ProductInterface|null $product */
  $product = $element['#object'] ?? NULL;
  if (!$product) {
    return;
  }

  // Title.
  $variables['product_title'] = $product->label();

  // Audience.
  $variables['audience_label'] = '';
  if ($product->hasField('field_audience') && !$product->get('field_audience')->isEmpty()) {
    $value = $product->get('field_audience')->value;
    $allowed = $product->getFieldDefinition('field_audience')->getSetting('allowed_values') ?? [];
    $variables['audience_label'] = $allowed[$value] ?? (string) $value;
  }

  // Activity type (supports both machine names).
  $variables['activity_type_label'] = '';
  foreach (['field_activity_type', 'field_acivity_type'] as $fname) {
    if ($product->hasField($fname) && !$product->get($fname)->isEmpty()) {
      $term = $product->get($fname)->entity;
      if ($term) {
        $variables['activity_type_label'] = $term->label();
      }
      break;
    }
  }

  // Hero background image (File or Media).
  $variables['hero_image_url'] = '';
  if ($product->hasField('field_primary_image') && !$product->get('field_primary_image')->isEmpty()) {
    $image_entity = $product->get('field_primary_image')->entity;
    $file = NULL;

    if ($image_entity instanceof FileInterface) {
      $file = $image_entity;
    }

    if (!$file && $image_entity instanceof MediaInterface) {
      foreach (['field_media_image', 'image', 'field_image'] as $media_field) {
        if ($image_entity->hasField($media_field) && !$image_entity->get($media_field)->isEmpty()) {
          $file = $image_entity->get($media_field)->entity;
          if ($file instanceof FileInterface) {
            break;
          }
          $file = NULL;
        }
      }
    }

    if ($file instanceof FileInterface) {
      $uri = $file->getFileUri();
      $style = ImageStyle::load('max_1300x1300');
      $variables['hero_image_url'] = $style
        ? $style->buildUrl($uri)
        : file_create_url($uri);
    }
  }
}
