{#
/**
 * @file
 * Form template for participant profile.
 *
 * Section order mirrors profile--participant.html.twig. Care-notes controls
 * (`field_has_allergies`, `field_has_additional_info`) sit next to the fields
 * they reveal so conditional_fields visibility changes are visible to the user.
 */
#}

{% set exclude = [
  'actions',
  'footer',

  'field_allergies',
  'field_additional_info',
  'field_has_allergies',
  'field_has_additional_info',
  'field_emercency_contact_1_name',
  'field_emercency_contact_1_phone',
  'field_emercency_contact_1_rel',
  'field_emercency_contact_1_pickup',
  'field_emercency_contact_2_name',
  'field_emercency_contact_2_phone',
  'field_emercency_contact_2_rel',
  'field_emercency_contact_2_pickup',
  'field_emercency_contact_3_name',
  'field_emercency_contact_3_phone',
  'field_emercency_contact_3_rel',
  'field_emercency_contact_3_pickup'
] %}

<form{{ attributes }}>

  {# Participant details — name, birth date, t-shirt, photo consent, swim test. #}
  <h2 class="title-lg font-bold mt-6 mb-3">{{ 'Participant details'|t }}</h2>
  {% for key, item in element %}
    {% if key|first != '#' and key not in exclude %}
      {{ item }}
    {% endif %}
  {% endfor %}

  {# Care notes. Pair each control with its conditional target. #}
  <h2 class="title-lg font-bold mt-6 mb-3">{{ 'Care notes'|t }}</h2>
  {% if element.field_has_allergies is defined %}{{ element.field_has_allergies }}{% endif %}
  {% if element.field_allergies is defined %}{{ element.field_allergies }}{% endif %}
  {% if element.field_has_additional_info is defined %}{{ element.field_has_additional_info }}{% endif %}
  {% if element.field_additional_info is defined %}{{ element.field_additional_info }}{% endif %}

  {# Emergency contacts. #}
  <h2 class="title-lg font-bold mt-6 mb-3">{{ 'Emergency contacts'|t }}</h2>

  <div class="emergency-contact border rounded-sm border-slate-300 my-4 p-3">
    <h3 class="title-sm font-semibold mb-1">{{ 'Primary contact'|t }}</h3>
    {% if element.field_emercency_contact_1_name is defined %}{{ element.field_emercency_contact_1_name }}{% endif %}
    {% if element.field_emercency_contact_1_rel is defined %}{{ element.field_emercency_contact_1_rel }}{% endif %}
    {% if element.field_emercency_contact_1_phone is defined %}{{ element.field_emercency_contact_1_phone }}{% endif %}
    {% if element.field_emercency_contact_1_pickup is defined %}{{ element.field_emercency_contact_1_pickup }}{% endif %}
  </div>

  <div class="emergency-contact border rounded-sm border-slate-300 my-4 p-3">
    <h3 class="title-sm font-semibold mb-1">{{ 'Secondary contact'|t }}</h3>
    {% if element.field_emercency_contact_2_name is defined %}{{ element.field_emercency_contact_2_name }}{% endif %}
    {% if element.field_emercency_contact_2_rel is defined %}{{ element.field_emercency_contact_2_rel }}{% endif %}
    {% if element.field_emercency_contact_2_phone is defined %}{{ element.field_emercency_contact_2_phone }}{% endif %}
    {% if element.field_emercency_contact_2_pickup is defined %}{{ element.field_emercency_contact_2_pickup }}{% endif %}
  </div>

  <div class="emergency-contact border rounded-sm border-slate-300 my-4 p-3">
    <h3 class="title-sm font-semibold mb-1">{{ 'Third contact'|t }}</h3>
    {% if element.field_emercency_contact_3_name is defined %}{{ element.field_emercency_contact_3_name }}{% endif %}
    {% if element.field_emercency_contact_3_rel is defined %}{{ element.field_emercency_contact_3_rel }}{% endif %}
    {% if element.field_emercency_contact_3_phone is defined %}{{ element.field_emercency_contact_3_phone }}{% endif %}
    {% if element.field_emercency_contact_3_pickup is defined %}{{ element.field_emercency_contact_3_pickup }}{% endif %}
  </div>

  {# Put these at the very bottom #}
  {% if element.footer is defined %}
    {{ element.footer }}
  {% endif %}

  {% if element.actions is defined %}
    {{ element.actions }}
  {% endif %}

</form>
