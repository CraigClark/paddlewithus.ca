{#
/**
 * @file
 * Default theme implementation to display a single page.
 *
 * @ingroup themeable
 */
#}

{% set navbar %}
  {{ include('ui_suite_daisyui:navbar', {
    start: page.navbar_start,
    center: page.navbar_center,
    end: page.navbar_end,
  }, with_context: false) }}
{% endset %}

{{ include('daisyui_ext:section', {
  content: navbar,
  attributes: create_attribute().addClass('pt-0', 'pb-0'),
  layout_attributes: create_attribute().addClass('container-sm'),
  content_attributes: create_attribute().addClass('mb-0')
}, with_context: false) }}

{#
  One menu instance only:
  - Mobile: drawer overlay + hamburger
  - Desktop: drawer forced open, overlay hidden, panel becomes static in flow
#}
<div class="drawer relative md:drawer-open">
  <input id="main-menu-drawer" type="checkbox" class="drawer-toggle" />

  {# Drawer content (page content area) #}
  <div class="drawer-content">
    {# MOBILE hamburger row (aligned to container-sm, icon on the right) #}
    <div class="container-sm md:hidden">
      <div class="flex justify-end">
        <label for="main-menu-drawer" class="btn btn-ghost btn-square" aria-label="{{ 'Open menu'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="block w-7 h-7">
            <path fill="currentColor" d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/>
          </svg>
        </label>
      </div>
    </div>

    {{ page.breadcrumb }}
    {{ page.highlighted }}

    <a id="main-content" tabindex="-1"></a>
    <main role="main" class="container-sm">
      {{ page.content }}
    </main>

    {{ page.footer }}
  </div>

  {# Drawer side (menu panel) #}
  <div class="drawer-side z-[1100] md:z-auto md:static">
    {# Overlay only on mobile; never on desktop (prevents click blocking) #}
    <label for="main-menu-drawer" class="drawer-overlay md:hidden" aria-label="{{ 'Close menu'|t }}"></label>

    {# Panel: fixed overlay on mobile, normal flow on desktop #}
    <div class="relative z-[1110] w-72 sm:w-80 min-h-full bg-base-100 p-4 md:z-auto md:w-auto md:min-h-0 md:bg-transparent md:p-0">
      {# Close button only on mobile #}
      <div class="flex justify-end md:hidden">
        <label for="main-menu-drawer" class="btn btn-ghost btn-square" aria-label="{{ 'Close menu'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="block w-7 h-7">
            <path fill="currentColor" d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3z"/>
          </svg>
        </label>
      </div>

      {# Desktop alignment wrapper #}
      <div class="container-sm md:container-none">
        {{ page.header }}
      </div>
    </div>
  </div>
</div>
