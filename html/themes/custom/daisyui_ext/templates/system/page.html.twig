{#
/**
 * @file
 * Default theme implementation to display a single page.
 *
 * BigPipe-safe navigation:
 * - Mobile menu uses `header` region
 * - Desktop menu uses `header_desktop` region
 * Each is a separate block instance with a unique placeholder ID.
 *
 * @ingroup themeable
 */
#}

{# ------------------------------------------------------------
 # Top navbar (branding, cart, account)
 # ------------------------------------------------------------ #}
{% set navbar %}
  {{ include('ui_suite_daisyui:navbar', {
    start: page.navbar_start,
    center: page.navbar_center,
    end: page.navbar_end,
  }, with_context: false) }}
{% endset %}

{{ include('daisyui_ext:section', {
  content: navbar,
  attributes: create_attribute().addClass('pt-0', 'pb-0'),
  layout_attributes: create_attribute().addClass('container-sm'),
  content_attributes: create_attribute().addClass('mb-0')
}, with_context: false) }}

{# ------------------------------------------------------------
 # MOBILE NAVIGATION (drawer)
 # ------------------------------------------------------------ #}
<div class="md:hidden">
  <div class="drawer relative">
    <input
      id="main-menu-drawer"
      type="checkbox"
      class="drawer-toggle"
    />

    {# Drawer content = page stays clickable #}
    <div class="drawer-content">
      <div class="container-sm">
        <div class="flex justify-end">
          <label
            for="main-menu-drawer"
            class="btn btn-ghost btn-square"
            aria-label="{{ 'Open menu'|t }}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="block w-7 h-7">
              <path fill="currentColor"
                d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z" />
            </svg>
          </label>
        </div>
      </div>
    </div>

    {# Drawer panel #}
    <div class="drawer-side z-[1100]">
      <label
        for="main-menu-drawer"
        class="drawer-overlay"
        aria-label="{{ 'Close menu'|t }}"
      ></label>

      <div class="relative z-[1110] w-72 sm:w-80 min-h-full bg-base-100 p-4">
        <div class="flex justify-end">
          <label
            for="main-menu-drawer"
            class="btn btn-ghost btn-square"
            aria-label="{{ 'Close menu'|t }}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="block w-7 h-7">
              <path fill="currentColor"
                d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3z" />
            </svg>
          </label>
        </div>

        {# Mobile menu block #}
        {{ page.header }}
      </div>
    </div>
  </div>
</div>

{# ------------------------------------------------------------
 # DESKTOP NAVIGATION (always visible)
 # ------------------------------------------------------------ #}
<div class="max-md:hidden container-sm">
  {{ page.header_desktop }}
</div>

{# ------------------------------------------------------------
 # Page chrome
 # ------------------------------------------------------------ #}
{{ page.breadcrumb }}
{{ page.highlighted }}

<a id="main-content" tabindex="-1"></a>

<main role="main" class="container-sm">
  {{ page.content }}
</main>

{{ page.footer }}
