{#
/**
 * @file
 * Clean order display template for PICC registration system.
 *
 * Available variables:
 * - order_entity: The order entity with direct property access.
 * - order: The rendered order fields (not used - we go direct to entity).
 */
#}

{# Hide the page title - it's redundant with our stats header #}
{% set title_suffix = '' %}

{# Get values directly from entity - skip field template rendering #}
{% set order_number = order_entity.getOrderNumber() %}
{% set email = order_entity.getEmail() %}
{% set completed_date = order_entity.getCompletedTime() %}
{% set placed_date = order_entity.getPlacedTime() %}
{% set state_label = order_entity.getState().getLabel() %}
{% set total = order_entity.getTotalPrice() %}
{% set subtotal = order_entity.getSubtotalPrice() %}

<div{{ attributes.addClass('order-display') }}>

  {# Order header with number and status #}
  <div class="stats shadow mb-6">
    <div class="stat">
      <div class="stat-title">{{ 'Order Number'|t }}</div>
      <div class="stat-value text-primary">{{ order_number }}</div>
    </div>
    <div class="stat">
      <div class="stat-title">{{ 'Status'|t }}</div>
      <div class="stat-value text-sm">{{ state_label }}</div>
    </div>
    <div class="stat">
      <div class="stat-title">{{ 'Order Date'|t }}</div>
      <div class="stat-value text-sm">{{ placed_date|format_date('medium') }}</div>
    </div>
  </div>

  {# Customer Information #}
  <div class="card bg-base-200 mb-6">
    <div class="card-body">
      <h2 class="card-title">{{ 'Contact Information'|t }}</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <div class="text-sm opacity-70">{{ 'Email'|t }}</div>
          <div class="font-medium">{{ email }}</div>
        </div>

        {% if order.billing_information is not empty %}
          <div>
            <div class="text-sm opacity-70">{{ 'Billing Address'|t }}</div>
            <div class="font-medium">
              {{ order.billing_information }}
            </div>
          </div>
        {% endif %}

        {% if order.shipping_information is not empty %}
          <div>
            <div class="text-sm opacity-70">{{ 'Shipping Address'|t }}</div>
            <div class="font-medium">
              {{ order.shipping_information }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# Order Items Table - render the view normally #}
  <div class="mb-6">
    <h2 class="text-2xl font-bold mb-4">{{ 'Registration Details'|t }}</h2>
    {{ order.order_items }}
  </div>

  {# Any additional custom fields #}
  {% if additional_order_fields is not empty %}
    <div class="mb-6">
      {{ additional_order_fields }}
    </div>
  {% endif %}

  {# Order Total #}
  <div class="flex justify-end">
    <div class="card bg-base-300 w-80">
      <div class="card-body">
        {% set adjustments = order_entity.getAdjustments() %}
        {% set has_adjustments = adjustments|length > 0 %}

        {% if has_adjustments %}
          <div class="flex justify-between text-lg">
            <span>{{ 'Subtotal'|t }}</span>
            <span>{{ subtotal|commerce_price_format }}</span>
          </div>

          {# Show each adjustment #}
          {% for adjustment in adjustments %}
            <div class="flex justify-between">
              <span class="text-sm">{{ adjustment.getLabel() }}</span>
              <span class="text-sm">{{ adjustment.getAmount()|commerce_price_format }}</span>
            </div>
          {% endfor %}

          <div class="divider my-2"></div>
        {% endif %}

        <div class="flex justify-between text-2xl font-bold">
          <span>{{ 'Total'|t }}</span>
          <span>{{ total|commerce_price_format }}</span>
        </div>
      </div>
    </div>
  </div>

</div>
