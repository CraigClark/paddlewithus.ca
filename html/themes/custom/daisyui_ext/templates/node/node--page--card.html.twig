<div class="card card-border border-neutral-300 w-full">
  <div class="card-body">
    <p class="card-title text-2xl font-semibold leading-tight">
      {{ label }}
    </p>
    {{ content.body }}
    <div class="card-actions">
      <a href="{{ url }}" class="btn btn-primary no-underline">{{ 'Read more'|t }}</a>
    </div>
  </div>
</div>
