<article{{ attributes }}>

  <div{{ content_attributes.addClass('hero', 'bg-base-200', 'my-12') }}>

    <div class="hero-content w-full max-w-7xl mx-auto gap-8
                grid grid-cols-1 lg:grid-cols-[24rem_1fr] items-start">

      {# Image column #}
      {% if node.field_page_primary_image is not empty %}
        <div class="aspect-square overflow-hidden rounded-lg shadow-2xl">
          {{ content.field_page_primary_image }}
        </div>
      {% endif %}

      {# Destination logic #}
      {% set destination = url %}
      {% if node.field_redirect is defined
        and node.field_redirect.value
        and node.field_redirect_destination is defined
        and node.field_redirect_destination is not empty
      %}
        {% set destination = node.field_redirect_destination.0.url.toString %}
      {% endif %}

      {% set cta = 'Read more'|t %}
      {% if node.field_link_text is defined and node.field_link_text.value is not empty %}
        {% set cta = node.field_link_text.value %}
      {% endif %}

      {# Content column #}
      <div>
        <h2 class="text-5xl font-bold">
          {{ label }}
        </h2>

        {% if node.field_summary is defined and node.field_summary.value is not empty %}
          <p class="py-6">
            {{ node.field_summary.value }}
          </p>
        {% endif %}

        <a href="{{ destination }}" class="btn btn-primary">
          {{ cta }}
        </a>
      </div>

    </div>

  </div>

</article>
