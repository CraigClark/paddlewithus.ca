{#
/**
 * Row template (Fields) for:
 * View: variant_session
 * Display: block_session
 */
#}

{# Product id #}
{% set pid = '' %}
{% if fields.product_id is defined %}
  {% set pid =
    fields.product_id.raw|default(fields.product_id.content|striptags|trim)
  %}
{% endif %}

{# Variation id #}
{% set vid = '' %}
{% if fields.variation_id is defined %}
  {% set vid =
    fields.variation_id.raw|default(fields.variation_id.content|striptags|trim)
  %}
{% endif %}

{# Discount 1 (numeric) #}
{% set dis_1 = 0 %}
{% if fields.field_discount_1 is defined %}
  {% set dis_1_raw = fields.field_discount_1.raw is defined
    and fields.field_discount_1.raw is not empty
    ? fields.field_discount_1.raw
    : fields.field_discount_1.content
  %}
  {% set dis_1_txt =
    dis_1_raw
      |render
      |striptags
      |trim
      |replace({
        '%': '',
        '$': '',
        ',': '',
        ' ': '',
        '\n': '',
        '\r': '',
        '\t': ''
      })
  %}
  {% set dis_1 = (dis_1_txt|default('0')) + 0 %}
{% endif %}

{# Discount 2 (numeric) #}
{% set dis_2 = 0 %}
{% if fields.field_discount_2 is defined %}
  {% set dis_2_raw = fields.field_discount_2.raw is defined
    and fields.field_discount_2.raw is not empty
    ? fields.field_discount_2.raw
    : fields.field_discount_2.content
  %}
  {% set dis_2_txt =
    dis_2_raw
      |render
      |striptags
      |trim
      |replace({
        '%': '',
        '$': '',
        ',': '',
        ' ': '',
        '\n': '',
        '\r': '',
        '\t': ''
      })
  %}
  {% set dis_2 = (dis_2_txt|default('0')) + 0 %}
{% endif %}

{# Discount 3 (numeric) #}
{% set dis_3 = 0 %}
{% if fields.field_discount_3 is defined %}
  {% set dis_3_raw = fields.field_discount_3.raw is defined
    and fields.field_discount_3.raw is not empty
    ? fields.field_discount_3.raw
    : fields.field_discount_3.content
  %}
  {% set dis_3_txt =
    dis_3_raw
      |render
      |striptags
      |trim
      |replace({
        '%': '',
        '$': '',
        ',': '',
        ' ': '',
        '\n': '',
        '\r': '',
        '\t': ''
      })
  %}
  {% set dis_3 = (dis_3_txt|default('0')) + 0 %}
{% endif %}

{# Discount 4 (numeric) #}
{% set dis_4 = 0 %}
{% if fields.field_discount_4 is defined %}
  {% set dis_4_raw = fields.field_discount_4.raw is defined
    and fields.field_discount_4.raw is not empty
    ? fields.field_discount_4.raw
    : fields.field_discount_4.content
  %}
  {% set dis_4_txt =
    dis_4_raw
      |render
      |striptags
      |trim
      |replace({
        '%': '',
        '$': '',
        ',': '',
        ' ': '',
        '\n': '',
        '\r': '',
        '\t': ''
      })
  %}
  {% set dis_4 = (dis_4_txt|default('0')) + 0 %}
{% endif %}

{# Discount 5+ (numeric) #}
{% set dis_5_up = 0 %}
{% if fields.field_discount_5_up is defined %}
  {% set dis_5_raw = fields.field_discount_5_up.raw is defined
    and fields.field_discount_5_up.raw is not empty
    ? fields.field_discount_5_up.raw
    : fields.field_discount_5_up.content
  %}
  {% set dis_5_txt =
    dis_5_raw
      |render
      |striptags
      |trim
      |replace({
        '%': '',
        '$': '',
        ',': '',
        ' ': '',
        '\n': '',
        '\r': '',
        '\t': ''
      })
  %}
  {% set dis_5_up = (dis_5_txt|default('0')) + 0 %}
{% endif %}

{% set has_discounts = dis_1 > 0
  or dis_2 > 0
  or dis_3 > 0
  or dis_4 > 0
  or dis_5_up > 0
%}

{% set date_range = fields.field_date_range is defined
  ? fields.field_date_range.content
  : ''
%}
{% set capacity = fields.field_capacity is defined
  ? fields.field_capacity.content
  : ''
%}
{% set price = fields.price__number is defined
  ? fields.price__number.content
  : ''
%}

{# Description field (optional) - keep Views output as-is (prevents &amp;) #}
{% set desc = fields.field_desc is defined ? fields.field_desc.content : '' %}

<div class="card bg-base-100 border border-base-300 mb-3">
  <div class="card-body p-4">
    {% if date_range %}
      <div class="font-semibold">
        {% if desc %}
          {{ desc }}, {{ date_range }}
        {% else %}
          {{ date_range }}
        {% endif %}
      </div>
    {% endif %}

    {% if capacity %}
      <div>
        {{ capacity }}
      </div>
    {% endif %}

    {% if price %}
      <div>
        {{ price }}
      </div>
    {% endif %}

    {% if has_discounts %}
      <details class="mt-2">
        <summary>
          {{ 'Family discounts'|t }}
        </summary>
        <ul>
          {% if dis_1 > 0 and fields.field_discount_1 is defined %}
            <li>
              {{ fields.field_discount_1.content }}{{ '% for first person'|t }}
            </li>
          {% endif %}
          {% if dis_2 > 0 and fields.field_discount_2 is defined %}
            <li>
              {{ fields.field_discount_2.content }}{{ '% for second person'|t }}
            </li>
          {% endif %}
          {% if dis_3 > 0 and fields.field_discount_3 is defined %}
            <li>
              {{ fields.field_discount_3.content }}{{ '% for third person'|t }}
            </li>
          {% endif %}
          {% if dis_4 > 0 and fields.field_discount_4 is defined %}
            <li>
              {{ fields.field_discount_4.content }}{{ '% for fourth person'|t }}
            </li>
          {% endif %}
          {% if dis_5_up > 0 and fields.field_discount_5_up is defined %}
            <li>
              {{ fields.field_discount_5_up.content }}{{ '% for fifth and each additional person'|t }}
            </li>
          {% endif %}
        </ul>
        <p>
          {{
            'Discount codes are for members of the same family attending the same session. If you have family members participating in different programs, please contact us.'|t
          }}
        </p>
      </details>
    {% endif %}
    {#
    <div class="alert alert-info border-2 mb-3 md:border-4 border-slate-950 bg-transparent"><p>{{ 'Registration will soon be open'|t }}</p>
    </div>
#}
    {% if pid %}
      <div class="mt-3">
        {% if logged_in and vid %}
          <a
            class="btn btn-primary btn-sm"
            href="{{
            path(
              'entity.webform.canonical',
              {
                webform: 'program_registration'
              },
              {
                query: {
                  product: pid,
                  variation: vid
                }
              }
            )
            }}"
          >
            {{ 'Register for this session'|t }}
          </a>
        {% else %}
          <a
            class="btn btn-primary btn-sm"
            href="{{
            path(
              'user.login',
              {},
              {
                query: {
                  destination: '/product/' ~ pid
                }
              }
            )
            }}"
          >
            {{ 'Log in or create account to register'|t }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
