{#
/**
 * @file
 * Theme override for fields in the swim test no-show review view.
 *
 * Row layout:
 * - Participant name (left)
 * - Excuse reason / notes (middle) — only if resolved
 * - Resolved / Undo action (right)
 */
#}
<div class="participant-row">
  <div class="font-medium text-base">
    {% if fields.field_name is defined %}
      {{ fields.field_name.content }}
    {% endif %}
  </div>
  {% if fields.field_swim_test_excuse_reason is defined and fields.field_swim_test_excuse_reason.content|render|trim %}
    <div class="font-medium text-base">
      {{ fields.field_swim_test_excuse_reason.content }}
    </div>
  {% endif %}
  <div class="participant-view-link">
    {% if fields.swim_test_action is defined %}
      {{ fields.swim_test_action.content }}
    {% endif %}
  </div>
</div>
