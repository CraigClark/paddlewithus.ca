{#
/**
 * @file
 * Theme override for fields in the swim test roster view (profile-based).
 *
 * Renders one row per participant with name + status badge + action.
 * The Evaluate button only appears for participants whose status is
 * none or failed (handled by the action field plugin).
 *
 * Designed for mobile use by coaches standing at the pool.
 */
#}
<div class="participant-row flex items-center gap-3">
  <div class="font-medium text-base flex-1">
    {% if fields.field_name is defined %}
      {{ fields.field_name.content }}
    {% endif %}
  </div>
  <div class="shrink-0">
    {% if fields.participant_swim_status_badge is defined %}
      {{ fields.participant_swim_status_badge.content }}
    {% endif %}
  </div>
  <div class="shrink-0">
    {% if fields.participant_swim_action is defined %}
      {{ fields.participant_swim_action.content }}
    {% endif %}
  </div>
</div>
