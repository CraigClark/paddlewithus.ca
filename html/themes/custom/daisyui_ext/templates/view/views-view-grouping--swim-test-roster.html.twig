{#
/**
 * @file
 * Theme override for views grouping in the swim test roster view.
 *
 * Groups by swim test date (one heading per day).
 *  - Level 0 (date): h2
 *  - Level 1 (if needed): h3
 */
#}
{% set heading = title|trim %}
{% if grouping_level == 0 %}
  <h2 class="text-2xl font-bold mt-12 mb-2 first:mt-0">{{ heading|default('Walk-up') }}</h2>
{% elseif heading %}
  <h3 class="text-lg font-semibold mt-6 mb-2 border-b border-base-300 pb-2">{{ heading }}</h3>
{% endif %}
{{ content }}
