/**
 * Use this file to override Tailwind CSS style utilities.
 */

/* ---- Registration view ---- */

/* Participant card row */
.participant-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  max-width: var(--readable-width);
  border: 1px solid var(--color-base-300);
  border-radius: var(--radius-lg, 0.5rem);
  padding: 0.75rem 1rem;
  background: var(--color-base-100);
}

.participant-view-link {
  flex-basis: 100%;
}

@media (min-width: 640px) {
  .participant-view-link {
    flex-basis: auto;
  }
}

/* Status icons — large enough to spot at a glance on a phone. */
.participant-icons {
  display: inline-flex;
  gap: 0.5rem;
  align-items: center;
  margin-left: auto;
}

.participant-icon .material-icons {
  font-size: 2rem;
  vertical-align: middle;
}

.participant-icon--swim .material-icons {
  color: var(--color-info);
}

.participant-icon--medical .material-icons {
  color: var(--color-error);
}

.participant-icon--photo .material-icons {
  color: var(--color-success);
}

/* Result count */
.registration-result-count {
  margin-bottom: 0.5rem;
}

/* ---- Attendance view ---- */

/* Card frame matches .participant-row visually but stacks its children:
 * top = name + icons, bottom = attendance actions block. */
.picc-attendance-card {
  max-width: var(--readable-width);
  border: 1px solid var(--color-base-300);
  border-radius: var(--radius-lg, 0.5rem);
  padding: 0.75rem 1rem;
  background: var(--color-base-100);
}

/* Name + icons row. Uses space-between so icons sit at the right when
 * there's room; when the name pushes them to the next line, the icons
 * become the sole item on their line and fall back to flex-start —
 * i.e. left-aligned — which is what we want on mobile. */
.picc-attendance-card__head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

/* Neutralise .participant-icons' margin-left: auto inside the card head
 * so justify-content decides alignment. Outside the card head (e.g. on
 * the registration roster) the original behaviour is preserved. */
.picc-attendance-card__head .participant-icons {
  margin-left: 0;
}

/* Legend */
.participant-legend-items {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;
  align-items: center;
}

.participant-legend-items > span {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.participant-legend-icon {
  font-size: 1.5rem;
  vertical-align: middle;
}

.participant-legend-icon--swim {
  color: var(--color-info);
}

.participant-legend-icon--medical {
  color: var(--color-error);
}

.participant-legend-icon--photo {
  color: var(--color-success);
}

/* Dialog close button: core Claro applies transform: translate(-50%, -50%)
 * which offsets the X from the centre of the circle since the icon element
 * already fills its parent. Reset the transform so the X is centred. */
.ui-dialog {
    & .ui-dialog-titlebar {
        & .ui-dialog-titlebar-close {
            .ui-icon.ui-icon-closethick {
              transform: none;
            }
        }
    }
}
