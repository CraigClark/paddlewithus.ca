/**
 * Use this file to add styles of basic HTML elements.
 */

 :root {
   --readable-width: 65ch;
   --color-primary: oklch(0.3676 0.1011 145.06);
   --color-primary-light: oklch(0.75 0.1011 145.06);
   --color-primary-md: oklch(0.47 0.1011 145.06);
   --color-primary-content: oklch(1 0 0 / 97%);
   --color-secondary: oklch(0.5574 0.1153 68.37);
   --color-secondary-content: oklch(0.9793 0.0176 81.83);
 }

@layer base {
  h1 {
    @apply title-xl font-bold;
  }
  h2 {
    @apply title-lg font-bold;
  }
  h3 {
    @apply title-md font-bold;
  }
  h4 {
    @apply title-sm font-bold;
  }
  h5 {
    @apply title-xs font-bold;
  }
  h6 {
    @apply title-2xs font-bold;
  }
}

@layer components {
  .layout-region-checkout-footer {
    @apply mt-3;
  }

  .form-actions .link--previous {
    @apply ms-3;
  }

  .form-item-field-name-0 label {
    @apply font-bold;
  }
}

@layer base {
  ul {
    @apply list-disc list-outside;
    padding-left: 1.5rem; /* or 2rem - gives space for bullets */
  }

  ol {
    @apply list-decimal list-outside;
    padding-left: 1.5rem;
  }
}



/* set global base font-size */
html {
  font-size: 18px;
}


.ext-banner h1 {
  padding: 2.25em 0;
}

/**
 * @file
 * Global link styling for PICC site using daisyUI.
 *
 * Makes links visible in content while preserving navigation styles.
 */

/* Style links in main content areas */
main a:not(.btn):not(.navbar *):not(.menu *):not(.tabs *):not([class*="card-"]),
.region-content a:not(.btn):not(.navbar *):not(.menu *):not(.tabs *):not([class*="card-"]),
.order-display a:not(.btn),
.views-table a:not(.btn) {
  @apply link link-primary link-hover;
}

/* Specific styling for table links to make them stand out */
.views-table td a:not(.btn) {
  @apply link link-primary font-medium;
}

/* Operation links styling */
.views-field-operations a,
.dropbutton a {
  @apply link link-hover;
}

/* indicate required fields */
.form-required::after {
  font-weight: 400;
  content: "❗";
}

/* form labels */

legend, label.label {
color: var(--color-neutral-950);
font-size: 1rem;
font-weight: 400;
}

.text-error {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--color-error);
}
.alert-error {
  border-color: var(--color-error);
}

.alert-info {
  border-color: var(--color-info);
}

.alert-warning {
  border-color: var(--color-warning);
}


/* Target webform checkbox labels */
.webform-type-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

/* Fix the label */
.webform-type-checkbox label {
  word-break: normal;
  overflow-wrap: break-word;
  white-space: normal;
}

h3 {
  margin-top: calc(var(--spacing) * 4);
}

p, li {
  margin-bottom: calc(var(--spacing) * 2);
}

h1, h2, h3, h4, h5, p, li, label {
  max-width: var(--readable-width);
}

.card-max-label {
  max-width: 45ch;
}

.card img {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

.card {
  overflow: hidden;
}

@media (min-width: 768px) {
  .filter-programs .form-actions {
    display: flex;
    align-items: flex-end;
    gap: .5em;
    margin-bottom: calc(var(--spacing) * 5);
  }
}


/* Remove native disclosure triangle */
summary::-webkit-details-marker {
  display: none;
}

summary::marker {
  display: none;
}

/* bust out of the container */
.full-width-of-screen {
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  width: 100vw;
}

/* shopping cart icon */
.cart--cart-block .cart-block--summary a {
    display: flex;
    align-items: center;
}

/* helpers */

.gradient-sky {
  background: linear-gradient(
    to bottom,
    oklch(94% 0.025 230) 0%,
    oklch(96% 0.015 235) 45%,
    oklch(93% 0.02 225) 100%
  );
}

.box-shadow-default {
  box-shadow:
  0 4px 6px -1px rgb(0 0 0 / 0.1),
  0 2px 4px -2px rgb(0 0 0 / 0.1);
}

.border-t-primary {
  border-top: 1px solid var(--color-primary-light);
}

.color-bg-primary-md {
  background: var(--color-primary-md);
}

.color-bg-primary-light {
  background: var(--color-primary-light);
}


/* front page hero */

.block-hero-front {
  display: flex;
  align-items: center;
  min-height: 50vh;
  background: linear-gradient(
    to bottom,
    oklch(94% 0.025 230) 0%,
    oklch(96% 0.015 235) 45%,
    oklch(93% 0.02 225) 100%
  );
}

.block-hero-front > div {
  display: grid;
  grid-template-rows: 1fr;
  gap: 1em;
  justify-items: center;
}

.block-hero-front .field--type-image {
  max-width: 200px;
}

@media (min-width: 768px) {
  .block-hero-front {
    padding: 2em;
  }
  .block-hero-front > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
    align-items: center;
  }

  .block-hero-front .field--type-image {
    max-width: 400px;
  }
}

nav.footer a,
nav.footer a:hover,
nav.footer a:visited,
nav.footer a:focus
 {
  color: var(--color-stone-50);
}

/* Align radio with multi-line label text */
.form-item.js-form-type-radio {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}

/* Prevent DaisyUI from vertically centering the radio */
.form-item.js-form-type-radio .form-radio {
  margin-top: 0.25rem; /* tweak if needed */
  flex-shrink: 0;
}

/* Ensure label text wraps cleanly */
.form-item.js-form-type-radio .option.label {
  line-height: 1.5;
  margin: 0;
  white-space: wrap;
  padding-top: .25em;
}

.form-item-field-shirt-size label,
.field--name-field-birth-date legend {
  font-weight: bold;
}
