/**
 * Use this file to add styles of basic HTML elements.
 */

 :root {
   --readable-width: 65ch;
   --color-primary: oklch(0.3676 0.1011 145.06);
   --color-primary-light: oklch(0.75 0.1011 145.06);
   --color-primary-md: oklch(0.47 0.1011 145.06);
   --color-primary-content: oklch(1 0 0 / 97%);
   --color-secondary: oklch(0.5574 0.1153 68.37);
   --color-secondary-content: oklch(0.9793 0.0176 81.83);
 }

@layer base {
  h1 {
    @apply title-xl font-bold;
  }
  h2 {
    @apply title-lg font-bold;
  }
  h3 {
    @apply title-md font-bold;
  }
  h4 {
    @apply title-sm font-bold;
  }
  h5 {
    @apply title-xs font-bold;
  }
  h6 {
    @apply title-2xs font-bold;
  }
}

@layer components {
  .layout-region-checkout-footer {
    @apply mt-3;
  }

  .form-actions .link--previous {
    @apply ms-3;
  }

  .form-item-field-name-0 label {
    @apply font-bold;
  }
}

@layer base {
  ul {
    @apply list-disc list-outside;
    padding-left: 1.5rem; /* or 2rem - gives space for bullets */
  }

  ol {
    @apply list-decimal list-outside;
    padding-left: 1.5rem;
  }
}



/* set global base font-size */
html {
  font-size: 18px;
}


.ext-banner h1 {
  padding: 2.25em 0;
}

/**
 * @file
 * Global link styling for PICC site using daisyUI.
 *
 * Makes links visible in content while preserving navigation styles.
 */

/* Style links in main content areas */
main a:not(.btn):not(.navbar *):not(.menu *):not(.tabs *):not([class*="card-"]),
.region-content a:not(.btn):not(.navbar *):not(.menu *):not(.tabs *):not([class*="card-"]),
.order-display a:not(.btn),
.views-table a:not(.btn) {
  @apply link link-primary link-hover;
}

/* Specific styling for table links to make them stand out */
.views-table td a:not(.btn) {
  @apply link link-primary font-medium;
}

/* Operation links styling */
.views-field-operations a,
.dropbutton a {
  @apply link link-hover;
}

/* indicate required fields */
.form-required::after {
  font-weight: 400;
  content: "❗";
}

/* form labels */

legend, label.label {
color: var(--color-neutral-950);
font-size: 1rem;
font-weight: 400;
}

.text-error {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--color-error);
}
.alert-error {
  border-color: var(--color-error);
}

.alert-info {
  border-color: var(--color-info);
}

.alert-warning {
  border-color: var(--color-warning);
}


/* Target webform checkbox labels */
.webform-type-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

/* Fix the label */
.webform-type-checkbox label {
  word-break: normal;
  overflow-wrap: break-word;
  white-space: normal;
}

h3 {
  margin-top: calc(var(--spacing) * 4);
}

p, li {
  margin-bottom: calc(var(--spacing) * 2);
}

h1, h2, h3, h4, h5, p, li, label {
  max-width: var(--readable-width);
}

.card-max-label {
  max-width: 45ch;
}

.card img {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

.card {
  overflow: hidden;
}

@media (min-width: 768px) {
  .filter-programs .form-actions {
    display: flex;
    align-items: flex-end;
    gap: .5em;
    margin-bottom: calc(var(--spacing) * 5);
  }
}


/* Remove native disclosure triangle */
summary::-webkit-details-marker {
  display: none;
}

summary::marker {
  display: none;
}

/* bust out of the container */
.full-width-of-screen {
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  width: 100vw;
}

/* shopping cart icon */
.cart--cart-block .cart-block--summary a {
    display: flex;
    align-items: center;
}

/* helpers */

.gradient-sky {
  background: linear-gradient(
    to bottom,
    oklch(94% 0.025 230) 0%,
    oklch(96% 0.015 235) 45%,
    oklch(93% 0.02 225) 100%
  );
}

.box-shadow-default {
  box-shadow:
  0 4px 6px -1px rgb(0 0 0 / 0.1),
  0 2px 4px -2px rgb(0 0 0 / 0.1);
}

.border-t-primary {
  border-top: 1px solid var(--color-primary-light);
}

.color-bg-primary-md {
  background: var(--color-primary-md);
}

.color-bg-primary-light {
  background: var(--color-primary-light);
}


/* front page hero */

.block-hero-front {
  display: flex;
  align-items: center;
  min-height: 50vh;
  background: linear-gradient(
    to bottom,
    oklch(94% 0.025 230) 0%,
    oklch(96% 0.015 235) 45%,
    oklch(93% 0.02 225) 100%
  );
}

.block-hero-front > div {
  display: grid;
  grid-template-rows: 1fr;
  gap: 1em;
  justify-items: center;
}

.block-hero-front .field--type-image {
  max-width: 200px;
}

@media (min-width: 768px) {
  .block-hero-front {
    padding: 2em;
  }
  .block-hero-front > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
    align-items: center;
  }

  .block-hero-front .field--type-image {
    max-width: 400px;
  }
}

nav.footer a,
nav.footer a:hover,
nav.footer a:visited,
nav.footer a:focus
 {
  color: var(--color-stone-50);
}

/* Align radio with multi-line label text */
.form-item.js-form-type-radio {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}

/* Prevent DaisyUI from vertically centering the radio */
.form-item.js-form-type-radio .form-radio {
  margin-top: 0.25rem; /* tweak if needed */
  flex-shrink: 0;
}

/* Ensure label text wraps cleanly */
.form-item.js-form-type-radio .option.label {
  line-height: 1.5;
  margin: 0;
  white-space: wrap;
  padding-top: .25em;
}

.form-item-field-shirt-size label,
.field--name-field-birth-date legend {
  font-weight: bold;
}

/* Hide contextual links wrapper that overlays the language switcher */
#block-daisyui-ext-languageswitcher > .contextual {
  display: none !important;
}

/* highlight french programs on programs page */

p.lang-fr {
  background: yellow;
  padding: .5em;
  border-radius: .5em;
  border: 1px solid black;
}

/* Backdrop for jQuery UI dialogs (used by picc_attendance + picc_registration).
 * Drupal's `data-dialog-type="dialog"` doesn't render a `.ui-widget-overlay`,
 * so we fake one with a body pseudo-element: dim the page, block clicks,
 * lock body scroll. Excludes off-canvas dialogs (Settings Tray etc).
 *
 * z-index 1259 sits just below the dialog (Gin sets `.ui-dialog` to 1260)
 * so the backdrop covers admin toolbar and other high-z elements but stays
 * behind the dialog itself. */
body:has(.ui-dialog:not(.ui-dialog-off-canvas))::before {
  content: '';
  position: fixed;
  inset: 0;
  background-color: rgb(0 0 0 / 50%);
  z-index: 1259;
}

body:has(.ui-dialog:not(.ui-dialog-off-canvas)) {
  overflow: hidden;
}

/* Make the entire dialog scroll as one unit, not the content area alone.
 * Gin defaults `.ui-dialog-content` to `overflow: auto` (sticky header +
 * sticky buttonpane, scrollable middle), which traps the action buttons
 * behind the iOS keyboard when a textarea is focused. With the whole
 * dialog scrolling, the user can drag inside the modal to reach any
 * field or button regardless of keyboard state. `dvh` shrinks the cap
 * when the on-screen keyboard is up (iOS 15.4+); `vh` is the fallback. */
.ui-dialog:not(.ui-dialog-off-canvas) {
  /* Pin to viewport top so the full max-height fits in view. jQuery UI
   * sets a variable `top` inline (20–30px depending on call); leaving it
   * alone causes max-height: 100dvh to extend past the viewport and clip
   * our trailing padding. */
  top: 0 !important;
  max-height: 100vh;
  max-height: 100dvh;
  overflow-y: auto;
  /* Trailing space inside the modal so the user can see they've reached
   * the end when scrolled to the bottom. */
  padding-bottom: 1rem;
}

.ui-dialog:not(.ui-dialog-off-canvas) .ui-widget-content.ui-dialog-content {
  overflow: visible;
  /* jQuery UI sets inline `height: auto; max-height: 0px` on the content
   * (leftovers from its dialog size calc). With overflow:auto that's
   * harmless — the content scrolls within its allocated flex space. With
   * our overflow:visible override the `max-height: 0` collapses the
   * content box to just its padding, and the form paints below the
   * buttonpane. Forcing both `height: auto` and `max-height: none` lets
   * the content size to its natural height. */
  height: auto !important;
  max-height: none !important;
}


/* Prevent iOS Safari from auto-zooming when focusing a form control.
 * iOS zooms whenever focused control font-size < 16px. DaisyUI's
 * `--font-size` variable fix is bypassed inside jQuery UI dialogs because
 * `.ui-widget textarea/input` sets `font-size: 1em` directly with higher
 * specificity (which resolves below 16px). Force >= 16px on all
 * text-entry controls under `pointer: coarse`. */
@media (pointer: coarse) {
  textarea,
  .ui-widget textarea,
  input[type="text"],
  input[type="email"],
  input[type="number"],
  input[type="password"],
  input[type="search"],
  input[type="tel"],
  input[type="url"],
  input:not([type]),
  .ui-widget input,
  select,
  .ui-widget select {
    font-size: 16px;
  }
}

/* Accessible disabled buttons. DaisyUI's default washes text out below
 * WCAG AA contrast. Keep text fully readable and signal "non-interactive"
 * via neutral background + not-allowed cursor instead of low opacity.
 * Match DaisyUI's :not(.btn-link, .btn-ghost) specificity so we override
 * its background; also reset --btn-fg since DaisyUI sets it to a 20%
 * mix that's the actual cause of the washout. */
.btn:disabled:not(.btn-link, .btn-ghost),
.btn[disabled]:not(.btn-link, .btn-ghost),
.btn-disabled:not(.btn-link, .btn-ghost) {
  background-color: var(--color-base-300);
  color: var(--color-base-content);
  border-color: var(--color-base-300);
  --btn-fg: var(--color-base-content);
  opacity: 1;
  cursor: not-allowed;
}

/* wrap form items if there is an inline error */
.form-item--error {
  flex-wrap: wrap;
}

.form-item--error-message {
  width: 100%;
}

.border-secondary {
  border-color: var(--color-secondary);
 }

 /* links in conent */

 main p a {
   text-decoration-line: underline;
   text-decoration-style: solid;
   text-underline-offset: 0.15em;
   @apply font-medium;
 }


