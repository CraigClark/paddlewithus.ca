/**
 * Evening program status notice.
 *
 * Rendered by the `evening_program_status` view (a content block on the front
 * page). One shared treatment — layout, typography, spacing, border, the edit
 * button — for every state; only the semantic colour changes:
 *   .program_on         → success  (programs are on)
 *   .program_off        → error    (programs are cancelled)
 *   .program_pending    → warning  (decision pending, check back)
 *   .program_no_update  → neutral  (nothing reported today)
 *
 * Colours come from the DaisyUI theme, so they follow light/dark automatically.
 * The edit link is admin-only and tinted from the notice's own text colour, so
 * it reads as a button and stays legible on every background.
 */
@layer components {
  .evening-prog-status {
    --notice-bg: var(--color-base-200);
    --notice-fg: var(--color-base-content);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    /* Leave a 1rem gutter each side so the rounded corners never touch the
       screen edge on mobile; capped at 46rem and centred on wider screens. */
    width: calc(100% - 2rem);
    max-width: 46rem;
    margin-inline: auto;
    /* Equal breathing room above and below so it doesn't butt against the nav. */
    margin-block: 1.5rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid color-mix(in oklch, var(--notice-fg) 22%, transparent);
    border-radius: 1rem;
    background-color: var(--notice-bg);
    color: var(--notice-fg);
    text-align: center;
    box-shadow: 0 2px 8px -3px color-mix(in oklch, var(--notice-fg) 35%, transparent);
  }

  .evening-prog-status p {
    margin: 0;
    max-width: var(--readable-width, 65ch);
  }

  /* Headline — the status sentence. */
  .evening-prog-status strong,
  .evening-prog-status.program_no_update p {
    display: block;
    font-size: clamp(1.2rem, 1rem + 1.1vw, 1.6rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  /* Meta — the "Last updated …" line. */
  .evening-prog-status p + p {
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0.8;
  }

  /* Semantic state colours — the only thing that changes between states. */
  .evening-prog-status.program_on {
    --notice-bg: var(--color-success);
    --notice-fg: var(--color-success-content);
  }

  .evening-prog-status.program_off {
    --notice-bg: var(--color-error);
    --notice-fg: var(--color-error-content);
  }

  .evening-prog-status.program_pending {
    --notice-bg: var(--color-warning);
    --notice-fg: var(--color-warning-content);
  }

  .evening-prog-status.program_no_update {
    --notice-bg: var(--color-base-200);
    --notice-fg: var(--color-base-content);
  }

  /* Edit link → button (admin only). */
  .evening-prog-status a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
    padding: 0.4rem 1.1rem;
    border: 1px solid color-mix(in oklch, var(--notice-fg) 45%, transparent);
    border-radius: 0.5rem;
    background-color: color-mix(in oklch, var(--notice-fg) 14%, transparent);
    color: var(--notice-fg);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .evening-prog-status a:hover,
  .evening-prog-status a:focus-visible {
    background-color: color-mix(in oklch, var(--notice-fg) 26%, transparent);
    border-color: color-mix(in oklch, var(--notice-fg) 60%, transparent);
    text-decoration: none;
  }
}
